{#
  Layout: Minimal
  Clean, compact banner — no title bar, just the message and
  two side-by-side buttons (Accept / Reject). Customize link below.
  Good for sites that want an unobtrusive consent notice.
#}
{% extends "gdpr/base.html.twig" %}

{% block banner %}
{# Minimal has no visible title, so the dialog is named with aria-label
   (the runtime resolves the placeholder per language) instead of an
   aria-labelledby pointing at a missing element. #}
<div id="Conzent" tabindex="-1" role="dialog" aria-label="[conzent_cookie_notice_banner_title]" aria-describedby="conzentBannerDesc" class="conzent-{{ banner_type }}{{ display_position }} cnz-minimal">
  <div class="conzent-inner-content-box" style="border:1px solid {{ colors.notice_border }};background-color:{{ colors.notice_bg }}">
    <div class="conzent-notice">
      <div class="content-wrap">
        <div class="msg-wrap" id="conzentBannerDesc" style="color:{{ colors.notice_description }}">
          {% if iab|default(false) %}[conzent_iab_notice_description]{% else %}[conzent_cookie_notice_message]{% endif %}
          {{ privacy_policy_link|raw }}
        </div>
        <div class="btn-wrap">
          {{ buttons_html|raw }}
        </div>
      </div>

      <div class="conzent-branding" style="display:flex;justify-content:flex-end;padding:6px 0 0;font-size:11px;opacity:0.7;">
        {{ branding_html|raw }}
      </div>
    </div>
  </div>
</div>
{% endblock %}
