# Application
APP_ENV=dev
APP_DEBUG=true
APP_SECRET=change-me-to-a-random-64-char-string
APP_URL=http://localhost

# Database
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=oci
DB_USER=oci
DB_PASSWORD=oci
DATABASE_URL=mysql://oci:oci@mariadb:3306/oci?charset=utf8mb4

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Monetization
MONETIZATION_MODEL=saas
PAYMENT_GATEWAY=stripe

# Stripe — dual-mode (set STRIPE_MODE to 'test' or 'live')
STRIPE_MODE=test
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_PRICING_TABLE_ID=
STRIPE_AGENCY_PRICING_TABLE_ID=

# Email (dev: Mailpit catches all; prod: Amazon SES)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=support@getconzent.com
MAIL_FROM_NAME="Conzent"

# Production Amazon SES (uncomment and fill for prod):
# MAIL_HOST=email-smtp.us-east-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# CMP / IAB TCF
# CMP_ID: Your registered IAB CMP ID (validated against the IAB CMP registry).
# When set to a valid CMP ID, TCF v2.3 features are automatically enabled.
# Leave empty or set to 0 for Community Edition (no TCF/IAB features).
CMP_ID=

# OpenRouter (AI Translation)
# Get a key at https://openrouter.ai — used for auto-translating banner content.
# Leave empty to disable the Auto Translate button.
OPENROUTER_API_KEY=

# AutoSEO webhook (POST /api/webhooks/autoseo)
# Flow: the webhook stores each article from getautoseo.com in the DB only
# (no files, no git, no build). The `autoseo-render` service then reconciles the
# DB into static pages in the shared /blog volume every ~60s (disk check on
# missing pages), which nginx serves live — no deploy, no downtime.
AUTOSEO_WEBHOOK_TOKEN=aseo_wh_your_token_here
AUTOSEO_VERIFY_SIGNATURE=true
AUTOSEO_SITE_URL=https://getconzent.com
AUTOSEO_AUTHOR="Conzent Team"
# Directory the renderer writes into = the served /blog volume. In the Coolify
# stack this is set on the autoseo-render service to the volume mount path.
# Locally it defaults to <base>/www/dist/blog.
AUTOSEO_BLOG_DIST=/var/www/html/www/dist/blog
AUTOSEO_RENDER_INTERVAL=60

# Google OAuth (used for "Sign in with Google" and GTM Wizard)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable "Tag Manager API" in APIs & Services → Library
# Set authorized redirect URIs:
#   {APP_URL}/auth/google/callback   (user login)
#   {APP_URL}/gtm/callback       (GTM wizard)
#   {APP_URL}/app/integrations/google-ads/callback   (Revenue Impact — Tier 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Revenue Impact — Tier 3 (live ad-platform data) ─────────────────
# Encryption key for OAuth tokens stored at rest (oci_ad_platform_connections).
# Generate with: php -r "echo base64_encode(random_bytes(32));"
TOKEN_ENCRYPTION_KEY=

# Google Ads API. Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above (add the
# adwords scope + the callback URI to the same OAuth client).
# Developer token: Google Ads → Tools → API Center. Apply for Basic access.
# This is the ONLY Google Ads value you set. Each customer authorises and picks
# their own Google Ads account via OAuth — nothing account-specific lives here.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: override the Google Ads API version the client targets (default v18).
#GOOGLE_ADS_API_VERSION=v18

# Meta Marketing API. Create a Business-type app at https://developers.facebook.com
# Request Advanced Access for ads_read + read_insights (App Review).
# Redirect URI: {APP_URL}/app/integrations/meta-ads/callback
# App-level only — each customer authorises and selects their own ad account.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# CDN (leave empty for local assets)
CDN_URL=

# Cloudflare (Edge cache purge on script regeneration)
# Get Zone ID from Cloudflare dashboard -> Overview -> API section
# Create API token at https://dash.cloudflare.com/profile/api-tokens with "Cache Purge" permission
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# GeoIP fallback (ipregistry.co) — used when MaxMind can't resolve an IP
IPREGISTRY_API_KEY=

# Scanning
SCAN_QUEUE_NAME=cookie_scans
SCAN_TIMEOUT=30

# Cookie scan server
# Shared secret between the app and the scanner container (must match the value
# the scanner runs with). Stored on the server row by `php bin/oci scanner:register`.
SCANNER_API_KEY=
# Internal URL the app uses to reach the scanner (Docker DNS name on the stack).
SCANNER_URL=http://scanner:8300
# Where scanner downtime/recovery alerts are emailed (falls back to MAIL_FROM_ADDRESS).
SCANNER_ALERT_EMAIL=
# Consecutive failed health checks before the first alert (scheduler polls every 5 min).
SCANNER_ALERT_FAILURES=2

# Cache
# Set to true to disable all caching layers (browser, Redis, Cloudflare, minification).
# Every page load fetches a fresh, unminified script. Useful for development and testing.
DISABLE_CACHE=false

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=stderr

# Newsletter (SendMails.io)
# Syncs user data to a mailing list on registration and profile updates.
# Tags are set automatically: OCI (self-hosted), CLOUD+PAID, or CLOUD+FREE.
SENDMAIL_API_URL=
SENDMAIL_API_KEY=
SENDMAIL_LIST_ID=

# Endpointr (email verification + SMTP credential vault)
# - Without a key, the signup-code modal still works locally via MAIL_* env vars,
#   but the daily users:verify-emails cron is a no-op.
# - With a key, MailerService pulls SMTP host/port/user/pass from the named vault
#   entry (default `amazon_ses`); MAIL_* env vars become the fallback if the
#   vault fetch fails. MAIL_FROM_ADDRESS and MAIL_FROM_NAME always come from env.
ENDPOINTR_API_KEY=
ENDPOINTR_SMTP_VAULT_NAME=amazon_ses
EMAIL_VERIFICATION_BATCH_SIZE=500
EMAIL_VERIFICATION_DELAY_MS=200

# Legacy Migration
# Comma-separated user IDs to exclude from legacy data migration
# Example: LEGACY_EXCLUDE_USER_IDS=1,5,99
LEGACY_EXCLUDE_USER_IDS=
# Remote legacy database for self-service account migration
# Example: LEGACY_DATABASE_URL=mysql://user:pass@host:3306/dbname?charset=utf8mb4
LEGACY_DATABASE_URL=
