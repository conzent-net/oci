            [1, 'personal', 'monthly', 2, 'trialing', 0, 0, null],
            [0, 'business', 'monthly', 1, 'trialing', 0, 0, null],
            [1, 'personal', 'yearly', 1, 'trialing', 0, 0, null],
            [0, 'business', 'monthly', 3, 'trialing', 0, 0, null],
            [1, 'personal', 'monthly', 1, 'trialing', 0, 0, null],
            [0, 'personal', 'monthly', 5, 'trialing', 0, 0, null],
            // past due
            [1, 'personal', 'monthly', 2, 'past_due', 0, 3, null],
            [0, 'business', 'monthly', 1, 'past_due', 0, 2, null],
            [1, 'personal', 'monthly', 1, 'past_due', 0, 1, null],
            // cancelled (one churned this month, others older)
            [0, 'personal', 'monthly', 1, 'cancelled', 0, 5, 0],
            [1, 'personal', 'monthly', 3, 'cancelled', 0, 6, 2],
            [0, 'business', 'monthly', 1, 'cancelled', 0, 8, 4],
            [1, 'personal', 'yearly', 2, 'cancelled', 0, 9, 7],
            [0, 'personal', 'monthly', 1, 'cancelled', 0, 4, 3],
            // expired
            [1, 'personal', 'monthly', 1, 'expired', 0, 10, null],
            [0, 'business', 'monthly', 2, 'expired', 0, 7, null],
        ];

        $subCount = 0;
        $linkedPayments = 0;
        foreach ($rows as [$ui, $plan, $cycle, $qty, $status, $life, $m, $cancel]) {
            $uid = $makeUser($subCount + 1);
            $demoUserIds[] = $uid;
            $created = $now->modify("-{$m} months");
            $trialStart = null;
            $trialEnd = null;
            if ($status === 'trialing') {
                $created = $now->modify('-3 days');
                $trialStart = $fmt($created);
                $trialEnd = $fmt($now->modify('+11 days'));
            } elseif ($life !== 1) {
                $trialStart = $fmt($created);
                $trialEnd = $fmt($created->modify('+14 days'));
            }

            $cancelledAt = null;
            $updated = $fmt($created);
            if ($cancel !== null) {
                $c = $now->modify("-{$cancel} months");
                $cancelledAt = $fmt($c);
                $updated = $fmt($c);
            }
            if ($status === 'expired') {
                $updated = $fmt($created); // keep old so it doesn't count as churn this month
            }

            $db->insert('oci_subscriptions', [
                'user_id' => $uid,
                'plan_key' => $plan,
                'billing_cycle' => $cycle,
                'quantity' => $qty,
                'status' => $status,
                'is_lifetime' => $life,
                'stripe_customer_id' => $tag,
                'trial_start' => $trialStart,
                'trial_end' => $trialEnd,
                'current_period_start' => $fmt($created),
                'current_period_end' => $fmt($now->modify('+20 days')),
                'cancelled_at' => $cancelledAt,
                'created_at' => $fmt($created),
                'updated_at' => $updated,
            ]);
            $subId = (int) $db->lastInsertId();
            $subCount++;

            // Linked payment for active recurring subs so the dashboard MRR
            // (which reads actual charges, not list price) is meaningful. The
            // yearly cycle invoices the full year. Every 4th sub gets a 50%
            // "voucher" to demonstrate plan-price vs actual-money divergence.
            if ($status === 'active' && $life === 0) {
                $perMonth = $pricing->calculatePrice($plan, $cycle, $qty);
                $invoice = $cycle === 'yearly' ? $perMonth * 12 : $perMonth;
                if ($subCount % 4 === 0) {
                    $invoice = round($invoice * 0.5, 2);
                }
                if ($invoice > 0) {
                    $db->insert('oci_transactions', [
                        'user_id' => $uid,
                        'subscription_id' => $subId,
                        'type' => 'payment',
                        'amount' => $invoice,
                        'currency' => 'EUR',
                        'description' => 'Demo recurring payment',
                        'external_reference' => $tag,
                        'created_at' => $fmt($now->modify('-10 days')),
                    ]);
                    $linkedPayments++;
                }
            }
        }

        // Transactions: an upward 12-month revenue trend + a couple of refunds.
        $pickDemo = static fn (int $i): int => $demoUserIds[$i % \count($demoUserIds)];
        $txCount = 0;
        for ($m = 11; $m >= 0; $m--) {
            $base = (12 - $m) * 40;
            for ($k = 1; $k <= 3; $k++) {
                $db->insert('oci_transactions', [
                    'user_id' => $pickDemo($m + $k),
                    'subscription_id' => null,
                    'type' => 'payment',
                    'amount' => $base + $k * 17 + ($m % 3) * 11,
                    'currency' => 'EUR',
                    'description' => 'Demo payment',
                    'external_reference' => $tag,
                    'created_at' => $fmt($now->modify("-{$m} months")),
                ]);
                $txCount++;
            }
        }
        foreach ([[0, 30, 2], [1, 45, 5]] as [$ui, $amt, $m]) {
            $db->insert('oci_transactions', [
                'user_id' => $pickDemo($ui),
                'subscription_id' => null,
                'type' => 'refund',
                'amount' => $amt,
                'currency' => 'EUR',
                'description' => 'Demo refund',
                'external_reference' => $tag,
                'created_at' => $fmt($now->modify("-{$m} months")),
            ]);
            $txCount++;
        }

        $appUrl = $_ENV['APP_URL'] ?? 'http://localhost:8100';
        $totalTx = $txCount + $linkedPayments;
        echo "Seeded demo billing data: {$subCount} customer(s) each with 1 subscription, "
            . "{$totalTx} transaction(s) ({$linkedPayments} linked to active subs for MRR).\n";
        echo "View it on the admin dashboard: {$appUrl}/admin\n";
        echo "Remove it later with: php bin/oci billing:demo clear\n";
    })(),

    default => (function () use ($command, $moduleCommands) {
        echo "OCI — Open Consent Infrastructure CLI\n\n";
        if ($command !== 'help') {
            echo "Unknown command: {$command}\n\n";
        }
        echo "Available commands:\n";
        echo "  setup                          First-run setup: create admin account\n";
        echo "  user:password --email=ADDR     Reset a user's password (generates one if omitted)\n";
        echo "  health                         Check application health\n";
        echo "  migrations:migrate             Run Doctrine schema migrations\n";
        echo "  legacy:migrate <domain|all>    Migrate legacy data to oci_* tables\n";
        echo "  cache:clear                    Clear application cache\n";
        echo "  queue:work                     Process queued jobs\n";
        echo "  ingest:flush                   Flush beacon buffer to database\n";
        echo "  schedule:run                   Run scheduled tasks\n";
        echo "  scanner:register [--url= --key=] Register/upsert a scan server (defaults to in-compose scanner)\n";
        echo "  scanner:health                 Ping scan servers; email alert on down/recovery\n";
        echo "  scripts:regenerate             Regenerate all consent scripts\n";
        echo "  cache:purge-loader             Purge CMP loader from Cloudflare edge\n";
        echo "  cleanup:non-admin-users        Delete all non-admin users and cascaded data\n";
        echo "  publish <version>              Publish core code to public GitHub repo\n";
        echo "  cookies:sync [--dry-run]        Sync Open Cookie Database into oci_cookies_global\n";
        echo "  cookies:translate               Translate cookie descriptions into all languages\n";
        echo "  banners:seed-translations      Pre-translate banner content for all languages\n";
        echo "  billing:demo <seed|clear>       Seed/remove demo billing data for the admin dashboard\n";
        echo "  users:verify-emails [--verbose] Verify PENDING email addresses (Endpointr API)\n";
        echo "  test:endpointr-vault [--name=]  Fetch a vault entry from Endpointr (default: amazon_ses)\n";
        echo "  test:email --to=ADDR            Send a diagnostic SMTP email with debug transcript\n";

        // Module-contributed commands (present only in the installed edition).
        if ($moduleCommands !== []) {
            echo "\nModule commands:\n";
            foreach ($moduleCommands as $name => $def) {
                $desc = \is_array($def) ? ($def['description'] ?? '') : '';
                echo '  ' . str_pad($name, 31) . $desc . "\n";
            }
        }
        echo "\n";
    })(),
};
