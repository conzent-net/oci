    'cleanup:non-admin-users' => (function () use ($container, $argv) {
        $db = $container->get(\Doctrine\DBAL\Connection::class);
        $dryRun = \in_array('--dry-run', $argv, true);

        $userCount = (int) $db->fetchOne("SELECT COUNT(*) FROM oci_users WHERE role != 'admin'");
        $siteCount = (int) $db->fetchOne('SELECT COUNT(*) FROM oci_sites');
        $orphanSiteCount = (int) $db->fetchOne("SELECT COUNT(*) FROM oci_sites WHERE user_id NOT IN (SELECT id FROM oci_users WHERE role = 'admin')");

        echo "Found {$userCount} non-admin user(s), {$siteCount} total site(s) ({$orphanSiteCount} to remove).\n";

        if ($userCount === 0 && $orphanSiteCount === 0) {
            echo "Nothing to clean up.\n";
            return;
        }

        if ($dryRun) {
            echo "Dry run — no changes made.\n";
            $users = $db->fetchAllAssociative("SELECT id, email, role FROM oci_users WHERE role != 'admin' ORDER BY id");
            foreach ($users as $u) {
                echo "  Would delete user: #{$u['id']} {$u['email']} ({$u['role']})\n";
            }
            $sites = $db->fetchAllAssociative("SELECT id, domain, user_id FROM oci_sites ORDER BY id");
            foreach ($sites as $s) {
                echo "  Would delete site: #{$s['id']} {$s['domain']} (user #{$s['user_id']})\n";
            }
            return;
        }

        // Delete all sites first (including any orphans not tied to an admin)
        $deletedSites = $db->executeStatement("DELETE FROM oci_sites WHERE user_id NOT IN (SELECT id FROM oci_users WHERE role = 'admin')");
        echo "Deleted {$deletedSites} site(s) and all cascaded data (banners, consents, etc.).\n";

        // Then delete non-admin users
        $deletedUsers = $db->executeStatement("DELETE FROM oci_users WHERE role != 'admin'");
        echo "Deleted {$deletedUsers} user(s) and all cascaded data.\n";

        // Also reset legacy_migrated_at so admin can re-test
        $db->executeStatement("UPDATE oci_users SET legacy_migrated_at = NULL WHERE role = 'admin'");
        echo "Reset legacy_migrated_at on admin user(s).\n";
    })(),

    'publish' => (function () use ($argv) {
        // Standalone script — no app bootstrap needed, runs with any PHP >= 8.0
        $script = dirname(__DIR__) . '/scripts/publish.php';
        $args = implode(' ', array_map('escapeshellarg', \array_slice($argv, 2)));
        $exitCode = 0;
        passthru("php \"{$script}\" {$args}", $exitCode);
        exit($exitCode);
    })(),

    'banners:seed-translations' => (function () use ($container, $argv) {
        $generate = \in_array('--generate', $argv, true);
        $insert = \in_array('--insert', $argv, true);
        $backfillSites = \in_array('--backfill-sites', $argv, true);
        $categories = \in_array('--categories', $argv, true);
        $dryRun = \in_array('--dry-run', $argv, true);
        $force = \in_array('--force', $argv, true);
        $lang = null;
        $delay = 2;

        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--lang=')) {
                $lang = substr($arg, 7);
            }
            if (str_starts_with($arg, '--delay=')) {
                $delay = (int) substr($arg, 8);
            }
        }

        if (!$generate && !$insert && !$categories) {
            echo "Usage: php bin/oci banners:seed-translations [options]\n\n";
            echo "Options:\n";
            echo "  --generate          Translate via AI and write to cache file\n";
            echo "  --insert            Read cache file and upsert into database\n";
            echo "  --backfill-sites    Also update existing site banners (untouched only)\n";
            echo "  --lang=XX           Process only one language code (e.g., --lang=da)\n";
            echo "  --delay=N           Seconds between API calls (default: 2)\n";
            echo "  --categories        Translate cookie categories for missing languages\n";
            echo "  --force             Re-translate even if cached (use after English changes)\n";
            echo "  --dry-run           Show what would happen without writing\n";
            return;
        }

        $db = $container->get(\Doctrine\DBAL\Connection::class);
        $ai = $container->get(\OCI\Infrastructure\Ai\AiClientInterface::class);
        $logger = $container->get(\Psr\Log\LoggerInterface::class);
        $basePath = $container->get('config.base_path');

        $seeder = new \OCI\Banner\Service\BannerTranslationSeeder($db, $ai, $logger, $basePath);

        echo "╔══════════════════════════════════════════╗\n";
        echo "║   Banner Translation Seeder               ║\n";
        echo "╚══════════════════════════════════════════╝\n\n";

        if ($dryRun) {
            echo "  DRY RUN — no changes will be written.\n\n";
        }
        if ($force) {
            echo "  FORCE — re-translating all languages (ignoring cache).\n\n";
        }

        // --- Phase 1: Generate translations via AI ---
        if ($generate) {
            $cached = $seeder->loadCachedTranslations();
            $targetLanguages = $seeder->getTargetLanguages();

            if ($lang !== null) {
                if (!isset($targetLanguages[$lang])) {
                    echo "ERROR: Language '{$lang}' not found in database.\n";
                    exit(1);
                }
                $targetLanguages = [$lang => $targetLanguages[$lang]];
            }

            $templates = ['gdpr', 'ccpa'];
            $totalLangs = \count($targetLanguages);
            $current = 0;
            $errors = 0;

            foreach ($templates as $template) {
                $fields = $seeder->getTranslatableFields($template);
                echo "Template: {$template} (" . \count($fields) . " fields)\n";

                if (!isset($cached[$template])) {
                    $cached[$template] = [];
                }

                $current = 0;
                foreach ($targetLanguages as $code => $name) {
                    $current++;
                    $pct = round($current / $totalLangs * 100);

                    // Skip if already cached (unless --force)
                    if (!$force && isset($cached[$template][$code]) && !empty($cached[$template][$code])) {
                        echo "  [{$pct}%] {$name} ({$code}) — cached, skipping\n";
                        continue;
                    }

                    echo "  [{$pct}%] {$name} ({$code}) — translating...";

                    if ($dryRun) {
                        echo " (dry run)\n";
                        continue;
                    }

                    $result = $seeder->translateForLanguage($code, $name, $fields);

                    if ($result === null) {
                        echo " FAILED\n";
                        $errors++;
                        continue;
                    }

                    // Count non-empty translations
                    $filled = \count(array_filter($result, fn($v) => $v !== ''));
                    echo " ✓ ({$filled}/" . \count($fields) . " fields)\n";

                    $cached[$template][$code] = $result;

                    // Save incrementally after each successful language
                    $seeder->saveCachedTranslations($cached);

                    // Rate limit
                    if ($delay > 0 && $current < $totalLangs) {
                        sleep($delay);
                    }
                }

                echo "\n";
            }

            if ($errors > 0) {
                echo "WARNING: {$errors} translation(s) failed. Re-run to retry.\n\n";
            }

            echo "Cache file written: resources/data/banner-field-translations.php\n\n";
        }

        // --- Phase 2: Insert into database ---
        if ($insert) {
            $cached = $seeder->loadCachedTranslations();

            if (empty($cached)) {
                echo "ERROR: No cached translations found. Run with --generate first.\n";
                exit(1);
            }

            // Count total entries
            $totalEntries = 0;
            foreach ($cached as $langs) {
                foreach ($langs as $fields) {
                    $totalEntries += \count($fields);
                }
            }

            echo "Inserting {$totalEntries} translations into oci_banner_field_translations...\n";

            $stats = $seeder->insertIntoDatabase($cached, $dryRun);

            echo "  Inserted: {$stats['inserted']}\n";
            echo "  Updated:  {$stats['updated']}\n";
            echo "  Skipped:  {$stats['skipped']}\n\n";

            // --- Phase 3: Backfill site banners ---
            if ($backfillSites) {
                echo "Backfilling existing site banners (untouched translations only)...\n";

                $bfStats = $seeder->backfillSiteBanners($cached, $dryRun);

                echo "  Updated: {$bfStats['updated']}\n";
                echo "  Skipped: {$bfStats['skipped']}\n\n";
            }

            if (!$dryRun) {
                echo "Done. Run 'php bin/oci scripts:regenerate' to update consent scripts.\n";
            }
        }

        // --- Phase 4: Cookie category translations ---
        if ($categories) {
            $cats = $seeder->getCookieCategories();
            $missingLangs = $seeder->getLanguagesMissingCategoryTranslations();

            if ($lang !== null) {
                $missingLangs = array_intersect_key($missingLangs, [$lang => true]);
            }

            if (empty($missingLangs)) {
                echo "All languages already have cookie category translations.\n";
            } else {
                echo "Translating cookie categories for " . \count($missingLangs) . " language(s)...\n";

                // Cache-first: the shipped static cache covers a fresh install
                // with no AI key; the API is only hit for uncached languages.
                $catCache = $seeder->loadCachedCategoryTranslations();

                $catErrors = 0;
                foreach ($missingLangs as $code => $name) {
                    $fromCache = !$force && isset($catCache[$code]) && $catCache[$code] !== [];

                    echo "  {$name} ({$code}) — " . ($fromCache ? 'cached...' : 'translating...');

                    if ($dryRun) {
                        echo " (dry run)\n";
                        continue;
                    }

                    if ($fromCache) {
                        $catResult = $catCache[$code];
                    } else {
                        $catResult = $seeder->translateCategoriesForLanguage($code, $name, $cats);

                        if ($catResult !== null) {
                            $catCache[$code] = $catResult;
                            $seeder->saveCachedCategoryTranslations($catCache);
                            if ($delay > 0) {
                                sleep($delay);
                            }
                        }
                    }

                    if ($catResult === null) {
                        echo " FAILED\n";
                        $catErrors++;
                        continue;
                    }

                    $count = $seeder->insertCategoryTranslations($code, $catResult);
                    echo " ✓ ({$count} inserted)\n";

                    if ($delay > 0) {
                        sleep($delay);
                    }
                }

                if ($catErrors > 0) {
                    echo "\nWARNING: {$catErrors} category translation(s) failed. Re-run to retry.\n";
                }

                echo "\n";
            }
        }
    })(),

    'billing:demo' => (function () use ($container, $argv) {
        $action = $argv[2] ?? '';
        $db = $container->get(\Doctrine\DBAL\Connection::class);
        $tag = 'seed_demo';

        // Demo rows are tagged so 'clear' can never touch real data:
        //   oci_users.account_id                 = 'seed_demo'
        //   oci_subscriptions.stripe_customer_id = 'seed_demo'
        //   oci_transactions.external_reference  = 'seed_demo'
        if ($action === 'clear') {
            $tx = $db->executeStatement('DELETE FROM oci_transactions WHERE external_reference = ?', [$tag]);
            $subs = $db->executeStatement('DELETE FROM oci_subscriptions WHERE stripe_customer_id = ?', [$tag]);
            $users = $db->executeStatement('DELETE FROM oci_users WHERE account_id = ?', [$tag]);
            echo "Removed demo billing data: {$users} customer(s), {$subs} subscription(s), {$tx} transaction(s).\n";
            return;
        }

        if ($action !== 'seed') {
            echo "Usage: php bin/oci billing:demo <seed|clear>\n\n";
            echo "  seed   Create sample demo customers with subscriptions and revenue\n";
            echo "         (MRR/churn/LTV/paying-vs-trial) so the admin dashboard and\n";
            echo "         /admin/billing are populated. All rows are tagged '{$tag}'.\n";
            echo "  clear  Remove every demo customer and their billing data.\n\n";
            echo "Demo rows are tagged, so 'clear' never touches real users or Stripe data.\n";
            return;
        }

        // Idempotent: remove any prior demo data before re-seeding.
        $db->executeStatement('DELETE FROM oci_transactions WHERE external_reference = ?', [$tag]);
        $db->executeStatement('DELETE FROM oci_subscriptions WHERE stripe_customer_id = ?', [$tag]);
        $db->executeStatement('DELETE FROM oci_users WHERE account_id = ?', [$tag]);

        $pricing = $container->get(\OCI\Monetization\Service\PricingService::class);
        $now = new \DateTimeImmutable('now');
        $fmt = static fn (\DateTimeImmutable $d): string => $d->format('Y-m-d H:i:s');
        // Each demo subscription belongs to its own demo customer, so per-user
        // aggregation (the dashboard dedupes to one sub per user) stays realistic.
        $demoPassword = password_hash('demo-' . bin2hex(random_bytes(8)), \PASSWORD_BCRYPT);
        $demoUserIds = [];
        $makeUser = static function (int $i) use ($db, $tag, $fmt, $now, $demoPassword): int {
            $db->insert('oci_users', [
                'username' => "demo-billing-{$i}",
                'email' => "demo-billing-{$i}@seed.local",
                'first_name' => 'Demo',
                'last_name' => "Customer {$i}",
                'password' => $demoPassword,
                'role' => 'customer',
                'is_active' => 1,
                'account_id' => $tag,
                'created_at' => $fmt($now),
                'updated_at' => $fmt($now),
            ]);
            return (int) $db->lastInsertId();
        };

        // [userIndex, plan, cycle, qty, status, lifetime, monthsAgo, cancelMonthsAgo|null]
        $rows = [
            // active personal monthly (spread over 12 months)
            [0, 'personal', 'monthly', 1, 'active', 0, 11, null],
            [1, 'personal', 'monthly', 2, 'active', 0, 10, null],
            [0, 'personal', 'monthly', 3, 'active', 0, 9, null],
            [1, 'personal', 'monthly', 1, 'active', 0, 8, null],
            [0, 'personal', 'monthly', 5, 'active', 0, 7, null],
            [1, 'personal', 'monthly', 8, 'active', 0, 6, null],
            [0, 'personal', 'monthly', 1, 'active', 0, 5, null],
            [1, 'personal', 'monthly', 2, 'active', 0, 4, null],
            [0, 'personal', 'monthly', 4, 'active', 0, 3, null],
            [1, 'personal', 'monthly', 1, 'active', 0, 2, null],
            [0, 'personal', 'monthly', 6, 'active', 0, 1, null],
            [1, 'personal', 'monthly', 1, 'active', 0, 0, null],
            // active personal yearly
            [0, 'personal', 'yearly', 2, 'active', 0, 10, null],
            [1, 'personal', 'yearly', 5, 'active', 0, 7, null],
            [0, 'personal', 'yearly', 1, 'active', 0, 5, null],
            [1, 'personal', 'yearly', 3, 'active', 0, 2, null],
            // active business monthly
            [0, 'business', 'monthly', 1, 'active', 0, 9, null],
            [1, 'business', 'monthly', 3, 'active', 0, 6, null],
            [0, 'business', 'monthly', 10, 'active', 0, 4, null],
            [1, 'business', 'monthly', 2, 'active', 0, 1, null],
            [0, 'business', 'monthly', 1, 'active', 0, 0, null],
            // active business yearly
            [1, 'business', 'yearly', 5, 'active', 0, 8, null],
            [0, 'business', 'yearly', 1, 'active', 0, 3, null],
            // lifetime (one-time paid, active)
            [0, 'business', 'lifetime', 2, 'active', 1, 6, null],
            [1, 'personal', 'lifetime', 1, 'active', 1, 2, null],
            // trialing (started this month)
            [0, 'personal', 'monthly', 1, 'trialing', 0, 0, null],
            [1, 'personal', 'monthly', 2, 'trialing', 0, 0, null],
            [0, 'business', 'monthly', 1, 'trialing', 0, 0, null],
            [1, 'personal', 'yearly', 1, 'trialing', 0, 0, null],
            [0, 'business', 'monthly', 3, 'trialing', 0, 0, null],
            [1, 'personal', 'monthly', 1, 'trialing', 0, 0, null],
            [0, 'personal', 'monthly', 5, 'trialing', 0, 0, null],
            // past due
            [1, 'personal', 'monthly', 2, 'past_due', 0, 3, null],
            [0, 'business', 'monthly', 1, 'past_due', 0, 2, null],
            [1, 'personal', 'monthly', 1, 'past_due', 0, 1, null],
            // cancelled (one churned this month, others older)
            [0, 'personal', 'monthly', 1, 'cancelled', 0, 5, 0],
            [1, 'personal', 'monthly', 3, 'cancelled', 0, 6, 2],
            [0, 'business', 'monthly', 1, 'cancelled', 0, 8, 4],
            [1, 'personal', 'yearly', 2, 'cancelled', 0, 9, 7],
            [0, 'personal', 'monthly', 1, 'cancelled', 0, 4, 3],
            // expired
            [1, 'personal', 'monthly', 1, 'expired', 0, 10, null],
            [0, 'business', 'monthly', 2, 'expired', 0, 7, null],
        ];

        $subCount = 0;
        $linkedPayments = 0;
        foreach ($rows as [$ui, $plan, $cycle, $qty, $status, $life, $m, $cancel]) {
            $uid = $makeUser($subCount + 1);
            $demoUserIds[] = $uid;
            $created = $now->modify("-{$m} months");
            $trialStart = null;
            $trialEnd = null;
            if ($status === 'trialing') {
                $created = $now->modify('-3 days');
                $trialStart = $fmt($created);
                $trialEnd = $fmt($now->modify('+11 days'));
            } elseif ($life !== 1) {
                $trialStart = $fmt($created);
                $trialEnd = $fmt($created->modify('+14 days'));
            }

            $cancelledAt = null;
            $updated = $fmt($created);
            if ($cancel !== null) {
                $c = $now->modify("-{$cancel} months");
                $cancelledAt = $fmt($c);
                $updated = $fmt($c);
            }
            if ($status === 'expired') {
                $updated = $fmt($created); // keep old so it doesn't count as churn this month
            }

            $db->insert('oci_subscriptions', [
                'user_id' => $uid,
                'plan_key' => $plan,
                'billing_cycle' => $cycle,
                'quantity' => $qty,
                'status' => $status,
                'is_lifetime' => $life,
                'stripe_customer_id' => $tag,
                'trial_start' => $trialStart,
                'trial_end' => $trialEnd,
                'current_period_start' => $fmt($created),
                'current_period_end' => $fmt($now->modify('+20 days')),
                'cancelled_at' => $cancelledAt,
                'created_at' => $fmt($created),
                'updated_at' => $updated,
            ]);
            $subId = (int) $db->lastInsertId();
            $subCount++;

            // Linked payment for active recurring subs so the dashboard MRR
            // (which reads actual charges, not list price) is meaningful. The
            // yearly cycle invoices the full year. Every 4th sub gets a 50%
            // "voucher" to demonstrate plan-price vs actual-money divergence.
            if ($status === 'active' && $life === 0) {
                $perMonth = $pricing->calculatePrice($plan, $cycle, $qty);
                $invoice = $cycle === 'yearly' ? $perMonth * 12 : $perMonth;
                if ($subCount % 4 === 0) {
                    $invoice = round($invoice * 0.5, 2);
                }
                if ($invoice > 0) {
                    $db->insert('oci_transactions', [
                        'user_id' => $uid,
                        'subscription_id' => $subId,
                        'type' => 'payment',
                        'amount' => $invoice,
                        'currency' => 'EUR',
                        'description' => 'Demo recurring payment',
                        'external_reference' => $tag,
                        'created_at' => $fmt($now->modify('-10 days')),
                    ]);
                    $linkedPayments++;
                }
            }
        }

        // Transactions: an upward 12-month revenue trend + a couple of refunds.
        $pickDemo = static fn (int $i): int => $demoUserIds[$i % \count($demoUserIds)];
        $txCount = 0;
        for ($m = 11; $m >= 0; $m--) {
            $base = (12 - $m) * 40;
            for ($k = 1; $k <= 3; $k++) {
                $db->insert('oci_transactions', [
                    'user_id' => $pickDemo($m + $k),
                    'subscription_id' => null,
                    'type' => 'payment',
                    'amount' => $base + $k * 17 + ($m % 3) * 11,
                    'currency' => 'EUR',
                    'description' => 'Demo payment',
                    'external_reference' => $tag,
                    'created_at' => $fmt($now->modify("-{$m} months")),
                ]);
                $txCount++;
            }
        }
        foreach ([[0, 30, 2], [1, 45, 5]] as [$ui, $amt, $m]) {
            $db->insert('oci_transactions', [
                'user_id' => $pickDemo($ui),
                'subscription_id' => null,
                'type' => 'refund',
                'amount' => $amt,
                'currency' => 'EUR',
                'description' => 'Demo refund',
                'external_reference' => $tag,
                'created_at' => $fmt($now->modify("-{$m} months")),
            ]);
            $txCount++;
        }

        $appUrl = $_ENV['APP_URL'] ?? 'http://localhost:8100';
        $totalTx = $txCount + $linkedPayments;
        echo "Seeded demo billing data: {$subCount} customer(s) each with 1 subscription, "
            . "{$totalTx} transaction(s) ({$linkedPayments} linked to active subs for MRR).\n";
        echo "View it on the admin dashboard: {$appUrl}/admin\n";
        echo "Remove it later with: php bin/oci billing:demo clear\n";
    })(),

    'email:verify' => (function () use ($container, $argv) {
        // End-to-end probe of the signup email gates. Run this ON THE SERVER
        // whenever a bogus address gets through: it shows exactly which layer
        // passed it, including the deep endpointr→Reoon call that the signup
        // flow fails OPEN on (a broken credential silently disables the gate).
        $address = trim((string) ($argv[2] ?? ''));
        if ($address === '') {
            echo "Usage: php bin/oci email:verify <address>\n";
            exit(1);
        }

        echo "Probing signup gates for: {$address}\n\n";

        echo "[1/2] Free checks (syntax, disposable list, MX/A DNS)\n";
        $validator = new \OCI\Identity\Service\EmailValidator();
        $error = $validator->validate($address);
        echo $error === null ? "      PASS\n" : "      REJECT — {$error}\n";

        echo "[2/2] Deep check (endpointr → Reoon)\n";
        if (trim((string) ($_ENV['ENDPOINTR_API_KEY'] ?? '')) === '') {
            echo "      FAIL — ENDPOINTR_API_KEY is not set in the environment.\n";
            echo "      The signup gate FAILS OPEN without it: every deep check is skipped.\n";
            exit(1);
        }

        try {
            $client = $container->get(\OCI\Identity\Service\EndpointrClient::class);
            $verdict = $client->verifyEmail($address);
            $raw = \is_array($verdict['raw'] ?? null) ? $verdict['raw'] : [];
            echo '      status: ' . (string) ($verdict['status'] ?? '?')
                . ', is_safe_to_send: ' . var_export($raw['is_safe_to_send'] ?? null, true)
                . ', is_role_account: ' . var_export($raw['is_role_account'] ?? null, true)
                . ', is_catch_all: ' . var_export($raw['is_catch_all'] ?? null, true) . "\n";

            // Mirror the exact signup gate decision from
            // EmailVerificationService::startSignup.
            $status = strtolower((string) ($verdict['status'] ?? ''));
            $invalid = \in_array($status, ['invalid', 'disposable', 'spamtrap', 'disabled'], true);
            $unsafe = ($raw['is_safe_to_send'] ?? null) === false
                && ($raw['is_role_account'] ?? false) !== true
                && ($raw['is_catch_all'] ?? false) !== true;
            echo ($invalid || $unsafe)
                ? "      REJECT — the signup gate blocks this address\n"
                : "      PASS — the signup gate allows this address\n";
        } catch (\Throwable $e) {
            echo '      FAIL — ' . $e::class . ': ' . $e->getMessage() . "\n";
            echo "      The signup gate FAILS OPEN on this error — fix the endpointr\n";
            echo "      credential (ENDPOINTR_API_KEY) or the customer's verification\n";
            echo "      priority (reoon) in the endpointr admin.\n";
            exit(1);
        }
    })(),

    'gtm:template-sync' => (function () use ($argv) {
        // Maintainer tool. Google does not store the file the template repository
        // publishes — on gallery ingest it re-serialises the INFO block — so the body
        // the wizard posts must be extracted from a container that installed the
        // template FROM THE GALLERY, together with that same container's
        // galleryReference. The two are one unit; refreshing one without the other
        // is what silently broke the wizard on 2026-09-01.
        $known = [
            'Conzent CMP' => ['out' => 'public/assets/gtm/templates/conzent.tpl', 'const' => 'CONZENT_GALLERY_REF'],
            'LinkedIn InsightTag 2.0' => ['out' => 'legacy/app/assets/gtm/templates/linkedIn.tpl', 'const' => 'LINKEDIN_GALLERY_REF'],
        ];

        $file = null;
        $name = 'Conzent CMP';
        $out = null;
        $write = false;
        foreach (\array_slice($argv, 2) as $arg) {
            if ($arg === '--write') {
                $write = true;
            } elseif (str_starts_with($arg, '--name=')) {
                $name = substr($arg, 7);
            } elseif (str_starts_with($arg, '--out=')) {
                $out = substr($arg, 6);
            } elseif (!str_starts_with($arg, '--')) {
                $file = $arg;
            }
        }

        if ($file === null || !is_file($file)) {
            echo "Usage: php bin/oci gtm:template-sync <container-export.json> [--name=\"Conzent CMP\"] [--out=PATH] [--write]\n\n";
            echo "Export a container version from GTM, or save the workspace templates API\n";
            echo "response, and point this at it. Writes the template body verbatim and prints\n";
            echo "the galleryReference; --write also updates the constant in GtmWizardService.\n";
            exit(1);
        }

        $json = json_decode((string) file_get_contents($file), true);
        if (!\is_array($json)) {
            echo "Not valid JSON: {$file}\n";
            exit(1);
        }

        $templates = $json['containerVersion']['customTemplate'] ?? $json['customTemplate'] ?? $json['template'] ?? null;
        if (!\is_array($templates)) {
            echo "No custom templates in that file (expected containerVersion.customTemplate[] or template[]).\n";
            exit(1);
        }

        $match = null;
        foreach ($templates as $t) {
            if (($t['name'] ?? '') === $name) {
                $match = $t;
                break;
            }
        }
        if ($match === null) {
            $found = implode(', ', array_map(static fn ($t) => (string) ($t['name'] ?? '?'), $templates));
            echo "No template named \"{$name}\". Found: {$found}\n";
            exit(1);
        }

        $body = (string) ($match['templateData'] ?? '');
        $ref = $match['galleryReference'] ?? null;
        if ($body === '') {
            echo "That template carries no templateData.\n";
            exit(1);
        }
        if (!\is_array($ref)) {
            echo "That template has no galleryReference, so it was not installed from the\n";
            echo "gallery and its body is not the one Google verifies against. Use a container\n";
            echo "that installed it from the gallery.\n";
            exit(1);
        }

        $target = $out ?? ($known[$name]['out'] ?? null);
        if ($target === null) {
            echo "No default path for \"{$name}\" — pass --out=PATH\n";
            exit(1);
        }

        $crs = substr_count($body, "\r");
        file_put_contents($target, $body);

        echo "Wrote {$target}\n";
        echo '  bytes  ' . \strlen($body) . "\n";
        echo '  sha256 ' . hash('sha256', $body) . "\n";
        if ($crs > 0) {
            echo "  ! {$crs} carriage returns in the payload — the export looks mangled.\n";
        }

        $keys = ['host', 'owner', 'repository', 'version', 'signature', 'galleryTemplateId'];
        echo "\ngalleryReference:\n";
        foreach ($keys as $k) {
            printf("        '%s' => '%s',\n", $k, (string) ($ref[$k] ?? ''));
        }

        $constName = $known[$name]['const'] ?? null;
        if (!$write) {
            echo "\nRe-run with --write to apply that to " . ($constName ?? 'the constant') . ".\n";
            return;
        }
        if ($constName === null) {
            echo "\nNo constant mapped for \"{$name}\" — apply the block above by hand.\n";
            exit(1);
        }

        $svc = 'src/Site/Service/GtmWizardService.php';
        $src = (string) file_get_contents($svc);
        $entries = '';
        foreach ($keys as $k) {
            $entries .= sprintf("        '%s' => '%s',\n", $k, addslashes((string) ($ref[$k] ?? '')));
        }
        $updated = preg_replace('/(private const ' . $constName . ' = \[\n).*?(    \];)/s', '${1}' . $entries . '${2}', $src, -1, $n);
        if ($n !== 1 || !\is_string($updated)) {
            echo "\nCould not locate {$constName} uniquely — left {$svc} untouched.\n";
            exit(1);
        }
        file_put_contents($svc, $updated);
        echo "\nUpdated {$constName} in {$svc}\n";
        echo "Verify with: vendor/bin/phpunit tests/Unit/Site/Service/GtmTemplateIntegrityTest.php\n";
    })(),
    default => (function () use ($command, $moduleCommands) {
        echo "OCI — Open Consent Infrastructure CLI\n\n";
        if ($command !== 'help') {
            echo "Unknown command: {$command}\n\n";
        }
        echo "Available commands:\n";
        echo "  setup                          First-run setup: create admin account\n";
        echo "  user:password --email=ADDR     Reset a user's password (generates one if omitted)\n";
        echo "  user:2fa-reset --email=ADDR    Turn off two-factor for a user (clears codes + devices)\n";
        echo "  health                         Check application health\n";
        echo "  migrations:migrate             Run Doctrine schema migrations\n";
        echo "  legacy:migrate <domain|all>    Migrate legacy data to oci_* tables\n";
        echo "  backup:run [--include-config]  Take a backup of this install now\n";
        echo "  security:layout-audit          Audit custom layouts for template-injection traces\n";
        echo "  cache:clear                    Clear application cache\n";
        echo "  queue:work                     Process queued jobs\n";
        echo "  queue:work-scripts             Process queued script regenerations only (run alongside queue:work)\n";
        echo "  ingest:flush                   Flush beacon buffer to database\n";
        echo "  schedule:run                   Run scheduled tasks\n";
        echo "  scanner:register [--url= --key=] Register/upsert a scan server (defaults to in-compose scanner)\n";
        echo "  scanner:health                 Ping scan servers; email alert on down/recovery\n";
        echo "  scripts:regenerate             Regenerate all consent scripts\n";
        echo "  billing:resync-sites [--apply] Reactivate billing-suspended sites for paying customers\n";
        echo "  consents:anonymize             Pseudonymize raw IPs in the consent log (destructive backfill)\n";
        echo "  account:export --user=<id|email> Export one account's data (zip of JSONL, public OCI schema)\n";
        echo "  account:import --file=<zip>    Import an account export into this installation (atomic)\n";
        echo "  cache:purge-loader             Purge CMP loader from Cloudflare edge\n";
        echo "  cleanup:non-admin-users        Delete all non-admin users and cascaded data\n";
        echo "  publish <version>              Publish core code to public GitHub repo\n";
        echo "  cookies:publish-pages [--only=NAME]  Write the public cookie database pages under public/cookie\n";
        echo "  cookies:sync [--dry-run]        Sync Open Cookie Database into oci_cookies_global\n";
        echo "  cookies:translate               Translate cookie descriptions into all languages\n";
        echo "  banners:seed-translations      Pre-translate banner content for all languages\n";
        echo "  billing:demo <seed|clear>       Seed/remove demo billing data for the admin dashboard\n";
        echo "  users:verify-emails [--verbose] Verify PENDING email addresses (Endpointr API)\n";
        echo "  test:endpointr-vault [--name=]  Fetch a vault entry from Endpointr (default: amazon_ses)\n";
        echo "  test:email --to=ADDR            Send a diagnostic SMTP email with debug transcript\n";
        echo "  gtm:template-sync <export.json> Re-sync a GTM gallery template body + reference\n";

        // Module-contributed commands (present only in the installed edition).
        if ($moduleCommands !== []) {
            echo "\nModule commands:\n";
            foreach ($moduleCommands as $name => $def) {
                $desc = \is_array($def) ? ($def['description'] ?? '') : '';
                echo '  ' . str_pad($name, 31) . $desc . "\n";
            }
        }
        echo "\n";
    })(),
};
