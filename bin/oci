            if (str_starts_with($arg, '--name=')) {
                $name = substr($arg, 7);
            }
        }

        $keyLen = \strlen($_ENV['ENDPOINTR_API_KEY'] ?? '');
        echo "─ Endpointr vault diagnostic ─\n";
        echo "  ENDPOINTR_API_KEY: " . ($keyLen > 0 ? "set ({$keyLen} chars)" : "MISSING") . "\n";
        echo "  Fetching vault entry: {$name}\n\n";

        if ($keyLen === 0) {
            echo "✗ ENDPOINTR_API_KEY is not set in the container environment.\n";
            exit(1);
        }

        $client = $container->get(\OCI\Identity\Service\EndpointrClient::class);

        try {
            $secrets = $client->getVaultEntry($name);
        } catch (\Throwable $e) {
            echo "✗ Vault fetch FAILED: {$e->getMessage()}\n";
            exit(1);
        }

        echo "✓ Vault fetch succeeded. Keys returned:\n";
        $sensitive = ['smtp_pass', 'password', 'secret', 'api_key', 'token', 'aws_secret_access_key'];
        foreach ($secrets as $k => $v) {
            $display = $v;
            if (\is_string($v) && \in_array(strtolower((string) $k), $sensitive, true)) {
                $len = \strlen($v);
                $display = $len > 0 ? substr($v, 0, 3) . str_repeat('*', max(0, $len - 6)) . substr($v, -3) . " (len={$len})" : '(empty)';
            } elseif (!\is_scalar($v)) {
                $display = json_encode($v);
            }
            printf("  %-20s = %s\n", (string) $k, (string) $display);
        }

        $required = ['smtp_host', 'smtp_port', 'smtp_user', 'smtp_pass'];
        $missing = array_diff($required, array_keys($secrets));
        if ($missing !== []) {
            echo "\n⚠  Missing expected SMTP keys: " . implode(', ', $missing) . "\n";
            exit(2);
        }

        echo "\n✓ All expected SMTP keys present. MailerService will use these on next send\n";
        echo "  (override vault entry name with ENDPOINTR_SMTP_VAULT_NAME; defaults to 'amazon_ses').\n";
    })(),

