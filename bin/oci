#!/usr/bin/env php
<?php

/**
 * OCI CLI — Command-line entry point.
 *
 * Replaces all legacy cron scripts with named, logged commands.
 *
 * Usage:
 *   php bin/oci <command> [options]
 *
 * Commands:
 *   setup                           First-run setup: create admin account
 *   health                         Check application health
 *   migrations:migrate             Run database migrations
 *   legacy:migrate <domain|all>    Migrate legacy data to oci_* tables
 *   cache:clear                    Clear application cache
 *   queue:work                     Process queued jobs (long-running)
 *   ingest:flush                   Flush beacon buffer to DB (long-running)
 *   schedule:run                   Run scheduled tasks (long-running)
 *   scanner:register               Register/upsert a scan server (defaults to in-compose scanner)
 *   scanner:health                 Ping registered scan servers; email alert on down/recovery
 *   scripts:regenerate             Regenerate consent scripts for all active sites
 *   consents:anonymize             Pseudonymize raw IPs in the consent log (one-time backfill, destructive)
 *   account:export                 Export everything stored for one account as a zip of JSONL files
 *   account:import                 Import an account export zip into this installation (atomic)
 *   iab:update-vendor-list         Refresh the IAB Global Vendor List (TCF)
 *   cleanup:non-admin-users        Delete all non-admin users and cascaded data
 *   blog:generate [--max=N]        Generate blog articles from RSS feeds via AI
 *   www:translate [--lang=XX]      Auto-translate website content via AI
 *   publish <version>              Publish core code to public GitHub repo
 *   billing:demo <seed|clear>      Seed or remove demo billing data for the admin dashboard
 *   cookies:sync [--dry-run]       Sync Open Cookie Database into oci_cookies_global
 *   cookies:translate               Translate cookie descriptions into all languages
 *   users:verify-emails            Run a single email-verification batch (Endpointr)
 *   test:endpointr-vault [--name=]  Fetch a vault entry from Endpointr (default: amazon_ses)
 *   test:email --to=ADDR           Send a diagnostic SMTP email with debug transcript
 *
 * Legacy Migration Options:
 *   --dry-run              Preview without writing data
 *   --batch-size=N         Rows per batch (default: 1000)
 *
 * Domains: users, sites, languages, categories, cookies, banners,
 *          consents, plans, scans, policies, agencies, all
 *
 * Environment:
 *   LEGACY_EXCLUDE_USER_IDS=1,5,99  Comma-separated user IDs to skip
 *
 * More commands will be added as domains are built.
 */

declare(strict_types=1);

use OCI\Http\Kernel\Application;
use OCI\Infrastructure\Database\LegacyMigrationRunner;

require_once dirname(__DIR__) . '/vendor/autoload.php';

$app = Application::boot(dirname(__DIR__));
$container = $app->getContainer();

// Simple CLI router (will be expanded into a proper CommandRunner)
$command = $argv[1] ?? 'help';

// ── Module-contributed commands & scheduled tasks ────────────────────
// Modules (Cloud Edition) register CLI commands and periodic tasks via their
// module.php 'commands'/'scheduled' keys. Collecting them here keeps this core
// entrypoint free of any reference to module classes — the open-source core
// ships without them and simply won't have those commands.
//
// Command shape:   ['cmd:name' => ['description' => string, 'run' => callable(ContainerInterface, array $argv)]]
// Scheduled shape: ['task:name' => callable(ContainerInterface)]
$moduleCommands = [];
$moduleScheduledTasks = [];
foreach ($app->getModuleRegistry()->all() as $module) {
    if ($module->commandsFile !== null) {
        $defs = require $module->commandsFile;
        if (\is_array($defs)) {
            $moduleCommands += $defs;
        }
    }
    if ($module->scheduledFile !== null) {
        $tasks = require $module->scheduledFile;
        if (\is_array($tasks)) {
            $moduleScheduledTasks += $tasks;
        }
    }
}

// Dispatch a module-provided command before the core match(), so core never
// references module classes. Handlers may exit() themselves or return an int.
if (isset($moduleCommands[$command])) {
    $def = $moduleCommands[$command];
    $run = \is_array($def) ? ($def['run'] ?? null) : $def;
    if (\is_callable($run)) {
        $result = $run($container, $argv);
        exit(\is_int($result) ? $result : 0);
    }
}

match ($command) {
    'setup' => (function () use ($container, $argv) {
        echo "╔══════════════════════════════════════════╗\n";
        echo "║   Conzent OCI — First-Run Setup          ║\n";
        echo "╚══════════════════════════════════════════╝\n\n";

        $db = $container->get(\Doctrine\DBAL\Connection::class);

        // Check if users table exists (migrations must run first)
        $tableExists = (bool) $db->fetchOne(
            "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'oci_users'",
        );
        if (!$tableExists) {
            echo "ERROR: Database tables not found. Run migrations first:\n";
            echo "  php bin/oci migrations:migrate\n\n";
            exit(1);
        }

        // Check if any users already exist
        $userCount = (int) $db->fetchOne('SELECT COUNT(*) FROM oci_users');
        if ($userCount > 0) {
            echo "Setup already completed ({$userCount} user(s) exist).\n";
            echo "Log in at: " . ($_ENV['APP_URL'] ?? 'http://localhost:8100') . "\n";
            exit(0);
        }

        // Parse CLI arguments: --email=x --password=x
        $email = null;
        $password = null;
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--email=')) {
                $email = substr($arg, 8);
            }
            if (str_starts_with($arg, '--password=')) {
                $password = substr($arg, 11);
            }
        }

        // Interactive mode if arguments not provided
        if ($email === null) {
            if (!defined('STDIN') || !posix_isatty(STDIN)) {
                echo "ERROR: No --email provided and no interactive terminal available.\n";
                echo "Usage: php bin/oci setup --email=admin@example.com --password=yourpassword\n\n";
                exit(1);
            }
            echo "Admin email: ";
            $email = trim(fgets(STDIN));
        }

        if ($password === null) {
            if (!defined('STDIN') || !posix_isatty(STDIN)) {
                echo "ERROR: No --password provided and no interactive terminal available.\n";
                echo "Usage: php bin/oci setup --email=admin@example.com --password=yourpassword\n\n";
                exit(1);
            }
            echo "Admin password (min 8 chars): ";
            // Attempt to hide input on Unix
            if (function_exists('readline')) {
                system('stty -echo 2>/dev/null');
                $password = trim(fgets(STDIN));
                system('stty echo 2>/dev/null');
                echo "\n";
            } else {
                $password = trim(fgets(STDIN));
            }
        }

        // Validate
        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            echo "ERROR: Invalid email address: {$email}\n";
            exit(1);
        }
        if (\strlen($password) < 8) {
            echo "ERROR: Password must be at least 8 characters.\n";
            exit(1);
        }

        // Create admin user via UserService
        $userService = $container->get(\OCI\Identity\Service\UserService::class);
        $result = $userService->createUser([
            'email' => $email,
            'username' => $email,
            'first_name' => 'Admin',
            'last_name' => '',
            'password' => $password,
            'role' => 'admin',
            'is_active' => 1,
        ]);

        if (!$result['success']) {
            echo "ERROR: Failed to create admin user.\n";
            foreach ($result['errors'] ?? [] as $field => $msg) {
                echo "  {$field}: {$msg}\n";
            }
            exit(1);
        }

        $appUrl = $_ENV['APP_URL'] ?? 'http://localhost:8100';

        echo "\n";
        echo "✓ Admin account created successfully!\n\n";
        echo "  Email:    {$email}\n";
        echo "  Role:     admin\n\n";
        echo "  Log in at: {$appUrl}\n\n";
    })(),

    // Reset any user's password from the host. `setup` deliberately refuses to
    // run once an account exists, and password-reset emails need SMTP — so on a
    // self-hosted install with no mail server this is the only recovery path.
    'user:password' => (function () use ($container, $argv) {
        $userRepo = $container->get(\OCI\Identity\Repository\UserRepositoryInterface::class);

        $email = null;
        $password = null;
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--email=')) {
                $email = trim(substr($arg, 8));
            }
            if (str_starts_with($arg, '--password=')) {
                $password = substr($arg, 11);
            }
        }

        if ($email === null || $email === '') {
            echo "ERROR: --email is required.\n";
            echo "Usage: php bin/oci user:password --email=admin@example.com [--password=newpassword]\n\n";
            exit(1);
        }

        $user = $userRepo->findByEmail($email);
        if ($user === null) {
            echo "ERROR: No user found with email: {$email}\n";
            exit(1);
        }

        // Generate a strong password when none is supplied — the common case
        // for "I locked myself out and there is no mail server".
        $generated = false;
        if ($password === null || $password === '') {
            $password = substr(bin2hex(random_bytes(12)), 0, 20);
            $generated = true;
        }

        if (\strlen($password) < 8) {
            echo "ERROR: Password must be at least 8 characters.\n";
            exit(1);
        }

        // UserRepository::update() bcrypt-hashes any value that isn't already a hash.
        $userRepo->update((int) $user['id'], ['password' => $password]);

        // Invalidate every existing session so the old password grants nothing.
        $userRepo->destroyUserSessions((int) $user['id']);

        // Clear any lockout from failed login attempts.
        $userRepo->resetLoginAttempts((int) $user['id']);

        $appUrl = $_ENV['APP_URL'] ?? 'http://localhost:8100';

        echo "\n";
        echo "✓ Password updated for {$email}\n\n";
        if ($generated) {
            echo "  New password: {$password}\n";
            echo "  (store it in a password manager — it is not saved anywhere)\n\n";
        }
        echo "  All existing sessions were signed out.\n";
        echo "  Log in at: {$appUrl}\n\n";
    })(),

    'health' => (function () use ($container, $app) {
        try {
            $db = $container->get(\Doctrine\DBAL\Connection::class);
            $db->fetchOne('SELECT 1');
            echo "Database: OK\n";
        } catch (\Throwable $e) {
            echo "Database: FAILED — {$e->getMessage()}\n";
        }

        try {
            $redis = $container->get(\Predis\Client::class);
            $redis->ping();
            echo "Redis: OK\n";
        } catch (\Throwable $e) {
            echo "Redis: FAILED — {$e->getMessage()}\n";
        }

        echo "Environment: {$app->getEnvironment()}\n";
        echo "Debug: " . ($app->isDebug() ? 'true' : 'false') . "\n";
    })(),

    'cache:clear' => (function () use ($container) {
        $cachePath = $container->get('config.base_path') . '/var/cache';
        if (is_dir($cachePath)) {
            $files = new RecursiveIteratorIterator(
                new RecursiveDirectoryIterator($cachePath, FilesystemIterator::SKIP_DOTS),
                RecursiveIteratorIterator::CHILD_FIRST,
            );
            foreach ($files as $file) {
                $file->isDir() ? rmdir($file->getRealPath()) : unlink($file->getRealPath());
            }
        }
        echo "Cache cleared.\n";
    })(),

    'queue:work' => (function () use ($container) {
        $scanService = $container->get(\OCI\Scanning\Service\ScanService::class);
        $exportJobs = $container->get(\OCI\Identity\Service\AccountExportJobService::class);
        $logger = $container->get(\Psr\Log\LoggerInterface::class);

        echo "Queue worker started. Waiting for jobs...\n";
        $logger->info('Queue worker started');

        $idleCount = 0;

        while (true) {
            try {
                $processed = $scanService->processNextScan();

                // Self-serve account exports ride the same worker; the scan
                // pop above blocks up to 5s, so exports start within seconds.
                if ($exportJobs->processNext()) {
                    $processed = true;
                }

                if ($processed) {
                    $idleCount = 0;
                } else {
                    $idleCount++;
                    // Check for stale scans every 60 idle cycles (~5 min with 5s blocking pop)
                    if ($idleCount % 60 === 0) {
                        $scanService->processStaleScans();
                    }
                }
            } catch (\Throwable $e) {
                $logger->error('Queue worker error: ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
                sleep(5);
            }
        }
    })(),

    'ingest:flush' => (function () use ($container) {
        $flushService = $container->get(\OCI\Scanning\Service\BeaconFlushService::class);
        $logger = $container->get(\Psr\Log\LoggerInterface::class);

        echo "Beacon flush worker started. Processing buffer...\n";
        $logger->info('Beacon flush worker started');

        while (true) {
            try {
                $count = $flushService->flush(200);

                if ($count === 0) {
                    usleep(500_000); // 500ms idle sleep
                }
            } catch (\Throwable $e) {
                $logger->error('Beacon flush error: ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
                sleep(5);
            }
        }
    })(),

    'schedule:run' => (function () use ($container, $moduleScheduledTasks) {
        $scanService = $container->get(\OCI\Scanning\Service\ScanService::class);
        $reportService = $container->get(\OCI\Report\Service\ReportService::class);
        $emailVerifier = $container->get(\OCI\Identity\Service\EmailVerificationService::class);
        $db = $container->get(\Doctrine\DBAL\Connection::class);
        $logger = $container->get(\Psr\Log\LoggerInterface::class);

        echo "Scheduler started. Checking every 5 minutes...\n";
        $logger->info('Scheduler started');

        while (true) {
            try {
                $scanService->processDueScheduledScans();
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (scans): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            try {
                $reportService->processDueSchedules();
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (reports): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Scan server health poll — pings each active scanner's /health,
            // records heartbeats, and emails an alert on down/recovery (deduped
            // so an outage sends one "down" mail and one "recovered" mail).
            try {
                $health = $container->get(\OCI\Scanning\Service\ServerHealthService::class)->checkAll();
                foreach ($health as $hr) {
                    if ($hr['alerted'] === 'down') {
                        echo "Scan server '{$hr['name']}' is DOWN — alert emailed.\n";
                    } elseif ($hr['alerted'] === 'recovered') {
                        echo "Scan server '{$hr['name']}' recovered — notice emailed.\n";
                    }
                }
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (scan server health): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Public status feed — written every cycle right after the health
            // poll so the getconzent.com status page reflects scanner state.
            // The feed's own freshness doubles as the scheduler heartbeat.
            try {
                $container->get(\OCI\Admin\Service\StatusReportService::class)->write();
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (status feed): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Backup heartbeat — arms itself on the first stamp the host's
            // backup script writes; from then on, a stale stamp alerts.
            try {
                $container->get(\OCI\Admin\Service\BackupFreshnessService::class)->check();
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (backup monitor): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Daily email verification sweep — runs at most once per 23 hours,
            // only between 04:00 and 06:00 (cheap API quota window).
            try {
                $now  = new \DateTimeImmutable();
                $hour = (int) $now->format('G');
                if ($hour >= 4 && $hour < 6) {
                    $last = $db->fetchOne(
                        "SELECT config_value FROM oci_configuration WHERE scope = 'global' AND scope_id IS NULL AND config_key = ?",
                        ['email_verification_last_run'],
                    );
                    $threshold = $now->modify('-23 hours')->format('Y-m-d H:i:s');
                    if (!$last || (string) $last < $threshold) {
                        $logger->info('Running daily email verification sweep');
                        $emailVerifier->runBatch(
                            (int) ($_ENV['EMAIL_VERIFICATION_BATCH_SIZE'] ?? 500),
                            (int) ($_ENV['EMAIL_VERIFICATION_DELAY_MS'] ?? 200),
                        );
                        $db->executeStatement(
                            "INSERT INTO oci_configuration (scope, scope_id, config_key, config_value)
                             VALUES ('global', NULL, ?, ?)
                             ON DUPLICATE KEY UPDATE config_value = VALUES(config_value)",
                            ['email_verification_last_run', $now->format('Y-m-d H:i:s')],
                        );
                    }
                }
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (email verification): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Daily IAB Global Vendor List refresh — runs at most once per 23
            // hours, between 06:00 and 08:00. TCF requires the GVL be kept
            // current; the v2.4 disclosures (standardTexts, Feature
            // illustrations, the renamed Special Feature 2) arrive purely as
            // GVL data and need no script regeneration to take effect.
            try {
                $gvl = $container->get(\OCI\Compliance\Service\GvlUpdateService::class);
                if ($gvl->isEnabled()) {
                    $now  = new \DateTimeImmutable();
                    $hour = (int) $now->format('G');
                    if ($hour >= 6 && $hour < 8) {
                        $last = $db->fetchOne(
                            "SELECT config_value FROM oci_configuration WHERE scope = 'global' AND scope_id IS NULL AND config_key = ?",
                            ['gvl_last_run'],
                        );
                        $threshold = $now->modify('-23 hours')->format('Y-m-d H:i:s');
                        if (!$last || (string) $last < $threshold) {
                            $logger->info('Running daily GVL refresh');
                            $result = $gvl->update();
                            if ($result->updated) {
                                echo "GVL updated: v{$result->previousVersion} → v{$result->newVersion}\n";
                                $gvl->updateTranslations();
                            }
                            foreach ($result->warnings as $warning) {
                                $logger->warning('GVL: ' . $warning);
                            }
                            // Stamp on every attempt, including "already current",
                            // so a healthy no-op doesn't retry every 5 minutes.
                            $db->executeStatement(
                                "INSERT INTO oci_configuration (scope, scope_id, config_key, config_value)
                                 VALUES ('global', NULL, ?, ?)
                                 ON DUPLICATE KEY UPDATE config_value = VALUES(config_value)",
                                ['gvl_last_run', $now->format('Y-m-d H:i:s')],
                            );
                        }
                    }
                }
            } catch (\Throwable $e) {
                // Validation failures leave the previous list serving untouched.
                $logger->error('Scheduler error (GVL refresh): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Consent-log retention — deletes records older than
            // CONSENT_LOG_RETENTION_DAYS (0 disables). At most once per 23
            // hours, between 02:00 and 04:00; satellites cascade via FK.
            try {
                $retentionDays = (int) ($_ENV['CONSENT_LOG_RETENTION_DAYS'] ?? 1095);
                if ($retentionDays > 0) {
                    $now  = new \DateTimeImmutable();
                    $hour = (int) $now->format('G');
                    if ($hour >= 2 && $hour < 4) {
                        $last = $db->fetchOne(
                            "SELECT config_value FROM oci_configuration WHERE scope = 'global' AND scope_id IS NULL AND config_key = ?",
                            ['consent_purge_last_run'],
                        );
                        $threshold = $now->modify('-23 hours')->format('Y-m-d H:i:s');
                        if (!$last || (string) $last < $threshold) {
                            $purged = $container->get(\OCI\Consent\Repository\ConsentRepositoryInterface::class)
                                ->purgeOlderThan($retentionDays);
                            if ($purged > 0) {
                                $logger->info("Consent retention: purged {$purged} record(s) older than {$retentionDays} days");
                                echo "Consent retention: purged {$purged} record(s).\n";
                            }
                            // Client-event dedupe ledger only needs to outlive
                            // the banner's 30-day offline queue TTL.
                            $ledgerPurged = $container->get(\OCI\Infrastructure\Ingest\ClientEventLedgerInterface::class)
                                ->purgeOlderThan(45);
                            if ($ledgerPurged > 0) {
                                $logger->info("Client event ledger: purged {$ledgerPurged} row(s) older than 45 days");
                            }
                            $db->executeStatement(
                                "INSERT INTO oci_configuration (scope, scope_id, config_key, config_value)
                                 VALUES ('global', NULL, ?, ?)
                                 ON DUPLICATE KEY UPDATE config_value = VALUES(config_value)",
                                ['consent_purge_last_run', $now->format('Y-m-d H:i:s')],
                            );
                        }
                    }
                }
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (consent retention): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Module-contributed periodic tasks (Cloud Edition) — e.g. AutoSEO
            // article translations. Registered via each module's config/scheduled.php
            // so this core scheduler references no module class. Each runs every
            // cycle (tasks are expected to be cheap no-ops when there's nothing to do).
            foreach ($moduleScheduledTasks as $taskName => $task) {
                try {
                    if (\is_callable($task)) {
                        $task($container);
                    }
                } catch (\Throwable $e) {
                    $logger->error("Scheduler error ({$taskName}): " . $e->getMessage());
                    echo "Error: {$e->getMessage()}\n";
                }
            }

            sleep(300); // Check every 5 minutes
        }
    })(),

    'scanner:register' => (function () use ($container, $argv) {
        $scanRepo = $container->get(\OCI\Scanning\Repository\ScanRepositoryInterface::class);

        // Defaults target the in-compose scanner. The internal Docker DNS name
        // is always reachable from the app/worker/scheduler containers.
        $url    = trim((string) ($_ENV['SCANNER_URL'] ?? 'http://scanner:8300'));
        $key    = (string) ($_ENV['SCANNER_API_KEY'] ?? '');
        $name   = 'Default Scanner';
        $region = null;
        $max    = (int) ($_ENV['SCANNER_MAX_CONCURRENT'] ?? 5);

        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--url='))    { $url = substr($arg, 6); }
            if (str_starts_with($arg, '--key='))    { $key = substr($arg, 6); }
            if (str_starts_with($arg, '--name='))   { $name = substr($arg, 7); }
            if (str_starts_with($arg, '--region=')) { $region = substr($arg, 9); }
            if (str_starts_with($arg, '--max='))    { $max = (int) substr($arg, 6); }
        }

        $url = rtrim($url, '/');
        if ($url === '') {
            echo "ERROR: --url is required (or set SCANNER_URL).\n";
            exit(1);
        }

        // Idempotent upsert keyed by URL.
        $existing = null;
        foreach ($scanRepo->getAllScanServers() as $s) {
            if (rtrim((string) $s['server_url'], '/') === $url) {
                $existing = $s;
                break;
            }
        }

        if ($existing !== null) {
            $scanRepo->updateScanServer((int) $existing['id'], [
                'server_name'    => $name,
                'api_key'        => $key !== '' ? $key : ($existing['api_key'] ?? null),
                'region'         => $region,
                'max_concurrent' => $max,
                'is_active'      => 1,
            ]);
            echo "Updated scan server #{$existing['id']}: {$name} -> {$url}\n";
        } else {
            $newId = $scanRepo->createScanServer([
                'server_name'    => $name,
                'server_url'     => $url,
                'api_key'        => $key !== '' ? $key : null,
                'region'         => $region,
                'is_active'      => 1,
                'max_concurrent' => $max,
                'current_load'   => 0,
            ]);
            echo "Registered scan server #{$newId}: {$name} -> {$url}\n";
        }

        if ($key === '') {
            echo "  NOTE: no API key set (SCANNER_API_KEY empty). Health checks still\n";
            echo "        work, but scan dispatch fails if the scanner requires a key.\n";
        }
        echo "Run 'php bin/oci scanner:health' to verify.\n";
    })(),

    'scanner:health' => (function () use ($container) {
        $svc = $container->get(\OCI\Scanning\Service\ServerHealthService::class);
        $results = $svc->checkAll();

        if ($results === []) {
            echo "No active scan servers registered.\n";
            echo "Register the in-compose scanner with: php bin/oci scanner:register\n";
            return;
        }

        printf("%-4s %-22s %-30s %-9s %s\n", 'ID', 'NAME', 'URL', 'STATUS', 'NOTE');
        echo str_repeat('-', 92) . "\n";
        foreach ($results as $r) {
            $status = $r['healthy'] ? 'healthy' : 'OFFLINE';
            $note   = $r['healthy'] ? '' : ('http=' . $r['http_code'] . ' ' . $r['error']);
            if ($r['alerted'] === 'down')      { $note .= '  [DOWN alert emailed]'; }
            if ($r['alerted'] === 'recovered') { $note  = '[recovery email sent]'; }
            printf(
                "%-4d %-22s %-30s %-9s %s\n",
                $r['id'],
                substr($r['name'], 0, 22),
                substr($r['url'], 0, 30),
                $status,
                $note,
            );
        }
    })(),

    'migrations:migrate' => (function () use ($container) {
        echo "Running OCI migrations...\n";

        $db = $container->get(\Doctrine\DBAL\Connection::class);

        // Ensure tracking table exists
        $db->executeStatement('
            CREATE TABLE IF NOT EXISTS oci_migration_versions (
                version VARCHAR(255) NOT NULL PRIMARY KEY,
                executed_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
        ');

        // Discover migration files
        $migrationsDir = dirname(__DIR__) . '/migrations/versions';
        $files = glob($migrationsDir . '/Version*.php');
        sort($files);

        if (empty($files)) {
            echo "No migration files found in {$migrationsDir}\n";
            return;
        }

        // Already executed
        $executed = $db->fetchFirstColumn('SELECT version FROM oci_migration_versions ORDER BY version');
        $executedMap = array_flip($executed);

        $pending = [];
        foreach ($files as $file) {
            $className = 'OCI\\Database\\Migrations\\' . pathinfo($file, PATHINFO_FILENAME);
            if (!isset($executedMap[$className])) {
                $pending[$className] = $file;
            }
        }

        if (empty($pending)) {
            echo "No new migrations to run. (" . \count($executed) . " already executed)\n";
            return;
        }

        echo \count($pending) . " new migration(s) to execute.\n\n";

        foreach ($pending as $className => $file) {
            require_once $file;

            if (!class_exists($className)) {
                echo "  SKIP: Class {$className} not found in {$file}\n";
                continue;
            }

            $shortName = pathinfo($file, PATHINFO_FILENAME);
            echo "  ▸ {$shortName}...";

            try {
                $migration = new $className($db);
                $migration->up();

                $db->insert('oci_migration_versions', [
                    'version' => $className,
                    'executed_at' => date('Y-m-d H:i:s'),
                ]);

                echo " ✓\n";
            } catch (\Throwable $e) {
                echo " ✗ {$e->getMessage()}\n";
                exit(1);
            }
        }

        echo "\nMigrations completed successfully.\n";
    })(),

