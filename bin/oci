    'consents:anonymize' => (function () use ($container) {
        $db = $container->get(\Doctrine\DBAL\Connection::class);
        $pseudonymizer = $container->get(\OCI\Consent\Service\IpPseudonymizer::class);

        if (trim((string) ($_ENV['CONSENT_IP_KEY'] ?? '')) === '') {
            echo "NOTE: CONSENT_IP_KEY is not set — IPs will be truncated (v4 /24, v6 /48) instead of HMAC-hashed.\n";
        }

        echo "Anonymizing raw IPs in oci_consents (destructive, batched)...\n";

        $lastId = 0;
        $updated = 0;
        $batch = 5000;

        while (true) {
            // Keyset pagination: already-hashed rows are skipped by the REGEXP,
            // and id > :lastId guarantees termination even when the fallback
            // truncation rewrites a value to itself.
            $rows = $db->fetchAllAssociative(
                "SELECT id, ip_address FROM oci_consents
                 WHERE id > :lastId AND ip_address != '' AND ip_address NOT REGEXP '^[0-9a-f]{64}$'
                 ORDER BY id ASC
                 LIMIT " . $batch,
                ['lastId' => $lastId],
                ['lastId' => \Doctrine\DBAL\ParameterType::INTEGER],
            );

            if ($rows === []) {
                break;
            }

            foreach ($rows as $row) {
                $lastId = (int) $row['id'];
                $pseudonym = $pseudonymizer->pseudonymize((string) $row['ip_address']);
                if ($pseudonym !== (string) $row['ip_address']) {
                    $db->update('oci_consents', ['ip_address' => $pseudonym], ['id' => $lastId]);
                    $updated++;
                }
            }

            echo "  ...processed up to id {$lastId} ({$updated} updated)\n";
        }

        echo "Done. {$updated} consent record(s) anonymized. Raw IPs are unrecoverable.\n";
    })(),

    'iab:update-vendor-list' => (function () use ($container, $argv) {
        $gvl    = $container->get(\OCI\Compliance\Service\GvlUpdateService::class);
        $force  = \in_array('--force', $argv, true);
        $dryRun = \in_array('--dry-run', $argv, true);
        $noTx   = \in_array('--no-translations', $argv, true);

        if (\in_array('--no-atp', $argv, true)) {
            $_ENV['GVL_UPDATE_ATP'] = 'false';
        }

        $current = $gvl->currentVersion();
        echo "IAB Global Vendor List\n";
        echo '  Source:  ' . $gvl->sourceUrl() . "\n";
        echo '  Current: ' . ($current === null
            ? 'none on disk'
            : "v{$current['version']} ({$current['lastUpdated']})") . "\n";

        if (!$gvl->isEnabled()) {
            echo "  GVL_AUTO_UPDATE is false — the bundled list is pinned. Nothing to do.\n";
            return;
        }

        try {
            $result = $gvl->update($force, $dryRun);
        } catch (\OCI\Compliance\Exception\GvlUpdateException $e) {
            // Nothing was written — the previous list is still serving.
            fwrite(STDERR, "  ✗ {$e->getMessage()}\n");
            exit(1);
        }

        if ($result->skipped) {
            echo "  ▸ {$result->reason}\n";
        } else {
            echo "  ✓ Updated v{$result->previousVersion} → v{$result->newVersion} ({$result->lastUpdated})\n";
        }

        if ($result->vendorCount > 0) {
            echo "    Vendors:       {$result->vendorCount}\n";
            echo "    Google ATP:    {$result->googleVendorCount}\n";
            echo '    standardTexts: ' . ($result->hasStandardTexts ? 'yes (TCF 2.4 ready)' : 'NO — v2.4 Feature disclosure will not render') . "\n";
        }

        foreach ($result->warnings as $warning) {
            echo "    ! {$warning}\n";
        }

        if (!$noTx && !$dryRun) {
            echo "  Fetching translations...\n";
            $tx     = $gvl->updateTranslations();
            $okList = array_keys(array_filter($tx));
            $failed = array_keys(array_filter($tx, static fn (bool $v): bool => !$v));

            echo '    Updated (' . \count($okList) . '): ' . (implode(', ', $okList) ?: '—') . "\n";
            if ($failed !== []) {
                echo '    Skipped (' . \count($failed) . '): ' . implode(', ', $failed) . "\n";
            }
        }

        echo "Done.\n";
    })(),

