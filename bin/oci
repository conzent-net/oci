#!/usr/bin/env php
<?php

/**
 * OCI CLI — Command-line entry point.
 *
 * Replaces all legacy cron scripts with named, logged commands.
 *
 * Usage:
 *   php bin/oci <command> [options]
 *
 * Commands:
 *   setup                           First-run setup: create admin account
 *   health                         Check application health
 *   migrations:migrate             Run database migrations
 *   legacy:migrate <domain|all>    Migrate legacy data to oci_* tables
 *   backup:run [--include-config]  Take a backup of this install now
 *   security:layout-audit          Check custom layouts for exploitation of the
 *                                  pre-2026-09-04 unsandboxed Twig rendering
 *   cache:clear                    Clear application cache
 *   queue:work                     Process queued jobs (long-running)
 *   queue:work-scripts             Process queued script regenerations only (long-running, run alongside queue:work)
 *   ingest:flush                   Flush beacon buffer to DB (long-running)
 *   schedule:run                   Run scheduled tasks (long-running)
 *   scanner:register               Register/upsert a scan server (defaults to in-compose scanner)
 *   scanner:health                 Ping registered scan servers; email alert on down/recovery
 *   scripts:regenerate             Regenerate consent scripts for all active sites
 *   billing:resync-sites           Reactivate sites suspended for billing under a paying customer
 *   consents:anonymize             Pseudonymize raw IPs in the consent log (one-time backfill, destructive)
 *   account:export                 Export everything stored for one account as a zip of JSONL files
 *   account:import                 Import an account export zip into this installation (atomic)
 *   iab:update-vendor-list         Refresh the IAB Global Vendor List (TCF)
 *   cleanup:non-admin-users        Delete all non-admin users and cascaded data
 *   blog:generate [--max=N]        Generate blog articles from RSS feeds via AI
 *   www:translate [--lang=XX]      Auto-translate website content via AI
 *   publish <version>              Publish core code to public GitHub repo
 *   billing:demo <seed|clear>      Seed or remove demo billing data for the admin dashboard
 *   cookies:publish-pages [--only=NAME]  Write the public cookie database pages under public/cookie
 *   cookies:sync [--dry-run]       Sync Open Cookie Database into oci_cookies_global
 *   cookies:translate               Translate cookie descriptions into all languages
 *   users:verify-emails            Run a single email-verification batch (Endpointr)
 *   test:endpointr-vault [--name=]  Fetch a vault entry from Endpointr (default: amazon_ses)
 *   test:email --to=ADDR           Send a diagnostic SMTP email with debug transcript
 *
 * Legacy Migration Options:
 *   --dry-run              Preview without writing data
 *   --batch-size=N         Rows per batch (default: 1000)
 *
 * Domains: users, sites, languages, categories, cookies, banners,
 *          consents, plans, scans, policies, agencies, all
 *
 * Environment:
 *   LEGACY_EXCLUDE_USER_IDS=1,5,99  Comma-separated user IDs to skip
 *
 * More commands will be added as domains are built.
 */

declare(strict_types=1);

use OCI\Http\Kernel\Application;
use OCI\Infrastructure\Database\LegacyMigrationRunner;

require_once dirname(__DIR__) . '/vendor/autoload.php';

$app = Application::boot(dirname(__DIR__));
$container = $app->getContainer();

// Simple CLI router (will be expanded into a proper CommandRunner)
$command = $argv[1] ?? 'help';

// ── Module-contributed commands & scheduled tasks ────────────────────
// Modules (Cloud Edition) register CLI commands and periodic tasks via their
// module.php 'commands'/'scheduled' keys. Collecting them here keeps this core
// entrypoint free of any reference to module classes — the open-source core
// ships without them and simply won't have those commands.
//
// Command shape:   ['cmd:name' => ['description' => string, 'run' => callable(ContainerInterface, array $argv)]]
// Scheduled shape: ['task:name' => callable(ContainerInterface)]
$moduleCommands = [];
$moduleScheduledTasks = [];
foreach ($app->getModuleRegistry()->all() as $module) {
    if ($module->commandsFile !== null) {
        $defs = require $module->commandsFile;
        if (\is_array($defs)) {
            $moduleCommands += $defs;
        }
    }
    if ($module->scheduledFile !== null) {
        $tasks = require $module->scheduledFile;
        if (\is_array($tasks)) {
            $moduleScheduledTasks += $tasks;
        }
    }
}

// Dispatch a module-provided command before the core match(), so core never
// references module classes. Handlers may exit() themselves or return an int.
if (isset($moduleCommands[$command])) {
    $def = $moduleCommands[$command];
    $run = \is_array($def) ? ($def['run'] ?? null) : $def;
    if (\is_callable($run)) {
        $result = $run($container, $argv);
        exit(\is_int($result) ? $result : 0);
    }
}

// The database host in DATABASE_URL is a Docker service name, so running this
// CLI from the host machine cannot resolve it. Unhandled, that surfaces as a
// 60-line PDOException stack trace that says nothing about the actual mistake.
// This turns it into the one sentence that fixes it.
set_exception_handler(static function (\Throwable $e): void {
    $message = $e->getMessage();

    if (str_contains($message, 'getaddrinfo') || str_contains($message, 'No such host')) {
        preg_match('/getaddrinfo for ([^\s]+) failed/', $message, $m);
        $host = $m[1] ?? 'the database host';

        fwrite(STDERR, "\n  Cannot reach the database: '{$host}' does not resolve from here.\n\n");
        fwrite(STDERR, "  That hostname belongs to the Docker network, so this command has to run\n");
        fwrite(STDERR, "  INSIDE the container rather than on the host:\n\n");
        fwrite(STDERR, "    docker compose exec app php bin/oci <command>\n\n");
        fwrite(STDERR, "  Or against a specific container:\n\n");
        fwrite(STDERR, "    docker exec conzent-app-app-1 php bin/oci <command>\n\n");
        exit(1);
    }

    if (str_contains($message, 'Connection refused') || str_contains($message, 'Access denied for user')) {
        fwrite(STDERR, "\n  Database connection failed: {$message}\n\n");
        fwrite(STDERR, "  Check DATABASE_URL, and that the database container is running:\n");
        fwrite(STDERR, "    docker compose ps\n\n");
        exit(1);
    }

    fwrite(STDERR, "\n  " . $e::class . ": {$message}\n");
    fwrite(STDERR, '  at ' . $e->getFile() . ':' . $e->getLine() . "\n\n");
    exit(1);
});

match ($command) {
    'setup' => (function () use ($container, $argv) {
        echo "╔══════════════════════════════════════════╗\n";
        echo "║   Conzent OCI — First-Run Setup          ║\n";
        echo "╚══════════════════════════════════════════╝\n\n";

        $db = $container->get(\Doctrine\DBAL\Connection::class);

        // Check if users table exists (migrations must run first)
        $tableExists = (bool) $db->fetchOne(
            "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'oci_users'",
        );
        if (!$tableExists) {
            echo "ERROR: Database tables not found. Run migrations first:\n";
            echo "  php bin/oci migrations:migrate\n\n";
            exit(1);
        }

        // Check if any users already exist
        $userCount = (int) $db->fetchOne('SELECT COUNT(*) FROM oci_users');
        if ($userCount > 0) {
            echo "Setup already completed ({$userCount} user(s) exist).\n";
            echo "Log in at: " . ($_ENV['APP_URL'] ?? 'http://localhost:8100') . "\n";
            exit(0);
        }

        // Parse CLI arguments: --email=x --password=x
        $email = null;
        $password = null;
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--email=')) {
                $email = substr($arg, 8);
            }
            if (str_starts_with($arg, '--password=')) {
                $password = substr($arg, 11);
            }
        }

        // Interactive mode if arguments not provided
        if ($email === null) {
            if (!defined('STDIN') || !posix_isatty(STDIN)) {
                echo "ERROR: No --email provided and no interactive terminal available.\n";
                echo "Usage: php bin/oci setup --email=admin@example.com --password=yourpassword\n\n";
                exit(1);
            }
            echo "Admin email: ";
            $email = trim(fgets(STDIN));
        }

        if ($password === null) {
            if (!defined('STDIN') || !posix_isatty(STDIN)) {
                echo "ERROR: No --password provided and no interactive terminal available.\n";
                echo "Usage: php bin/oci setup --email=admin@example.com --password=yourpassword\n\n";
                exit(1);
            }
            echo "Admin password (min 8 chars): ";
            // Attempt to hide input on Unix
            if (function_exists('readline')) {
                system('stty -echo 2>/dev/null');
                $password = trim(fgets(STDIN));
                system('stty echo 2>/dev/null');
                echo "\n";
            } else {
                $password = trim(fgets(STDIN));
            }
        }

        // Validate
        if (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            echo "ERROR: Invalid email address: {$email}\n";
            exit(1);
        }
        if (\strlen($password) < 8) {
            echo "ERROR: Password must be at least 8 characters.\n";
            exit(1);
        }

        // Create admin user via UserService
        $userService = $container->get(\OCI\Identity\Service\UserService::class);
        $result = $userService->createUser([
            'email' => $email,
            'username' => $email,
            'first_name' => 'Admin',
            'last_name' => '',
            'password' => $password,
            'role' => 'admin',
            'is_active' => 1,
        ]);

        if (!$result['success']) {
            echo "ERROR: Failed to create admin user.\n";
            foreach ($result['errors'] ?? [] as $field => $msg) {
                echo "  {$field}: {$msg}\n";
            }
            exit(1);
        }

        $appUrl = $_ENV['APP_URL'] ?? 'http://localhost:8100';

        echo "\n";
        echo "✓ Admin account created successfully!\n\n";
        echo "  Email:    {$email}\n";
        echo "  Role:     admin\n\n";
        echo "  Log in at: {$appUrl}\n\n";
    })(),

    // Reset any user's password from the host. `setup` deliberately refuses to
    // run once an account exists, and password-reset emails need SMTP — so on a
    // self-hosted install with no mail server this is the only recovery path.
    // The only 2FA recovery path in the self-hosted edition: there is no core
    // admin UI, so an operator whose user lost their authenticator needs this.
    // On Cloud the same service method sits behind the admin button.
    'user:2fa-reset' => (function () use ($container, $argv) {
        $userRepo = $container->get(\OCI\Identity\Repository\UserRepositoryInterface::class);
        $twoFactor = $container->get(\OCI\Identity\Service\TwoFactorService::class);

        $email = null;
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--email=')) {
                $email = trim(substr($arg, 8));
            }
        }

        if ($email === null || $email === '') {
            echo "Usage: php bin/oci user:2fa-reset --email=admin@example.com\n\n";
            echo "Turns two-factor OFF for the user and clears their recovery codes\n";
            echo "and trusted devices. They can enrol again from Account > Two-factor.\n";
            exit(1);
        }

        $user = $userRepo->findByEmail($email);
        if ($user === null) {
            echo "No user found with email: {$email}\n";
            exit(1);
        }

        $twoFactor->reset((int) $user['id']);
        $userRepo->destroyUserSessions((int) $user['id']);

        echo "Two-factor authentication reset for {$email}.\n";
        echo "Recovery codes and trusted devices cleared; active sessions ended.\n";
    })(),

    'user:password' => (function () use ($container, $argv) {
        $userRepo = $container->get(\OCI\Identity\Repository\UserRepositoryInterface::class);

        $email = null;
        $password = null;
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--email=')) {
                $email = trim(substr($arg, 8));
            }
            if (str_starts_with($arg, '--password=')) {
                $password = substr($arg, 11);
            }
        }

        if ($email === null || $email === '') {
            echo "ERROR: --email is required.\n";
            echo "Usage: php bin/oci user:password --email=admin@example.com [--password=newpassword]\n\n";
            exit(1);
        }

        $user = $userRepo->findByEmail($email);
        if ($user === null) {
            echo "ERROR: No user found with email: {$email}\n";
            exit(1);
        }

        // Generate a strong password when none is supplied — the common case
        // for "I locked myself out and there is no mail server".
        $generated = false;
        if ($password === null || $password === '') {
            $password = substr(bin2hex(random_bytes(12)), 0, 20);
            $generated = true;
        }

        if (\strlen($password) < 8) {
            echo "ERROR: Password must be at least 8 characters.\n";
            exit(1);
        }

        // UserRepository::update() bcrypt-hashes any value that isn't already a hash.
        $userRepo->update((int) $user['id'], ['password' => $password]);

        // Invalidate every existing session so the old password grants nothing.
        $userRepo->destroyUserSessions((int) $user['id']);

        // Clear any lockout from failed login attempts.
        $userRepo->resetLoginAttempts((int) $user['id']);

        $appUrl = $_ENV['APP_URL'] ?? 'http://localhost:8100';

        echo "\n";
        echo "✓ Password updated for {$email}\n\n";
        if ($generated) {
            echo "  New password: {$password}\n";
            echo "  (store it in a password manager — it is not saved anywhere)\n\n";
        }
        echo "  All existing sessions were signed out.\n";
        echo "  Log in at: {$appUrl}\n\n";
    })(),

    'health' => (function () use ($container, $app) {
        try {
            $db = $container->get(\Doctrine\DBAL\Connection::class);
            $db->fetchOne('SELECT 1');
            echo "Database: OK\n";
        } catch (\Throwable $e) {
            echo "Database: FAILED — {$e->getMessage()}\n";
        }

        try {
            $redis = $container->get(\Predis\Client::class);
            $redis->ping();
            echo "Redis: OK\n";
        } catch (\Throwable $e) {
            echo "Redis: FAILED — {$e->getMessage()}\n";
        }

        echo "Environment: {$app->getEnvironment()}\n";
        echo "Debug: " . ($app->isDebug() ? 'true' : 'false') . "\n";
    })(),

    // Take a backup now, from the CLI. The admin UI enqueues the same service;
    // this is the path a self-hoster puts on a host cron, and the one to reach
    // for when the app's own scheduler is what you suspect.
    'backup:run' => (function () use ($container, $argv) {
        $includeConfig = \in_array('--include-config', $argv, true);
        $trigger = \in_array('--scheduled', $argv, true) ? 'scheduled' : 'manual';

        if ($includeConfig) {
            echo "! Including .env — this archive will carry live credentials.\n";
        }

        try {
            $r = $container->get(\OCI\Admin\Service\BackupService::class)->create($trigger, $includeConfig);
        } catch (\Throwable $e) {
            fwrite(STDERR, "\n  Backup FAILED: {$e->getMessage()}\n\n");
            exit(1);
        }

        // Ship it. A host cron calling this must get the same offsite copies
        // the scheduled in-app run gets, or the two paths quietly diverge.
        $shipped = $container->get(\OCI\Admin\Service\BackupDestinationService::class)
            ->distribute($r['id'], $r['path']);

        printf(
            "\n  Backup complete\n    id      %d\n    file    %s\n    size    %.1f MB\n    sha256  %s\n\n",
            $r['id'],
            basename($r['path']),
            $r['size'] / 1048576,
            $r['sha256'],
        );

        foreach ($shipped as $name => $ok) {
            printf("    %-7s %s\n", $name, $ok ? 'uploaded' : 'FAILED');
        }
        echo "\n";
    })(),

    // Forensics for the pre-2026-09-04 layout rendering hole.
    //
    // Until then, banner layout source was compiled in an unsandboxed Twig
    // environment, and POST /app/layouts/preview accepted raw template source
    // from any authenticated account. Twig's map/filter/reduce/sort filters
    // take a callable by NAME, so that was arbitrary PHP execution.
    //
    // Every install that ran a build before that date was exposed, which is why
    // this ships rather than living in a private script.
    'security:layout-audit' => (function () use ($container, $argv) {
        $db = $container->get(\Doctrine\DBAL\Connection::class);

        $since = '2026-01-01';
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--since=')) {
                $since = substr($arg, 8);
            }
        }

        // Constructs that have no legitimate place in a banner layout. The
        // callable-taking filters are the actual execution vectors; the rest
        // are strong signals of someone probing rather than theming.
        $patterns = [
            'callable via reduce()' => '/\|\s*reduce\s*\(/i',
            'callable via map()' => '/\|\s*map\s*\(/i',
            'callable via filter()' => '/\|\s*filter\s*\(/i',
            'callable via sort()' => '/\|\s*sort\s*\(/i',
            '_self reference' => '/_self/i',
            'runtime template load' => '/\{%\s*(use|include|import|from|embed)\b/i',
            'dangerous PHP function name' => '/\b(system|exec|passthru|shell_exec|proc_open|popen|eval|assert|base64_decode|file_get_contents|file_put_contents|fopen|curl_exec)\b/i',
            'undefined-callback registration' => '/registerUndefined/i',
        ];

        echo "\n  Layout source audit\n";
        echo "  ────────────────────────────────────────────────────────────\n";

        $layouts = $db->fetchAllAssociative(
            'SELECT l.id, l.site_id, l.layout_name, l.html_content, l.created_at, l.updated_at,
                    s.domain, u.email
               FROM oci_custom_layouts l
          LEFT JOIN oci_sites s ON s.id = l.site_id
          LEFT JOIN oci_users u ON u.id = s.user_id
           ORDER BY l.updated_at DESC',
        );

        $flagged = 0;
        foreach ($layouts as $row) {
            $hits = [];
            foreach ($patterns as $label => $regex) {
                if (preg_match($regex, (string) $row['html_content']) === 1) {
                    $hits[] = $label;
                }
            }

            if ($hits !== []) {
                ++$flagged;
                printf(
                    "\n  ! layout #%d \"%s\"\n    site: %s   owner: %s\n    created %s, updated %s\n    matched: %s\n",
                    $row['id'],
                    $row['layout_name'],
                    $row['domain'] ?? 'unknown',
                    $row['email'] ?? 'unknown',
                    $row['created_at'],
                    $row['updated_at'],
                    implode(', ', $hits),
                );
            }
        }

        printf("\n  %d custom layouts scanned, %d flagged.\n", \count($layouts), $flagged);

        // Accounts that existed while the hole was open.
        echo "\n  Accounts created since {$since}\n";
        echo "  ────────────────────────────────────────────────────────────\n";
        $users = $db->fetchAllAssociative(
            'SELECT u.id, u.email, u.role, u.created_at, u.last_login_at, u.last_login_ip,
                    (SELECT COUNT(*) FROM oci_sites s WHERE s.user_id = u.id) AS sites,
                    (SELECT COUNT(*) FROM oci_custom_layouts l
                       JOIN oci_sites s2 ON s2.id = l.site_id WHERE s2.user_id = u.id) AS layouts
               FROM oci_users u
              WHERE u.created_at >= ?
           ORDER BY u.created_at',
            [$since],
        );

        printf("  %-5s %-34s %-9s %-19s %6s %8s\n", 'id', 'email', 'role', 'created', 'sites', 'layouts');
        foreach ($users as $u) {
            printf(
                "  %-5d %-34s %-9s %-19s %6d %8d\n",
                $u['id'],
                mb_substr((string) $u['email'], 0, 34),
                $u['role'],
                $u['created_at'],
                (int) $u['sites'],
                (int) $u['layouts'],
            );
        }
        printf("  %d accounts.\n", \count($users));

        // Layout events that WERE recorded.
        echo "\n  Layout events in the audit log\n";
        echo "  ────────────────────────────────────────────────────────────\n";
        $events = $db->fetchAllAssociative(
            "SELECT a.created_at, a.action, a.entity_id, a.ip_address, u.email
               FROM oci_audit_log a
          LEFT JOIN oci_users u ON u.id = a.user_id
              WHERE a.entity_type LIKE '%Layout%' AND a.created_at >= ?
           ORDER BY a.created_at DESC
              LIMIT 100",
            [$since],
        );

        foreach ($events as $e) {
            printf("  %s  %-8s #%-5s %-16s %s\n", $e['created_at'], $e['action'], $e['entity_id'] ?? '-', $e['ip_address'] ?? '-', $e['email'] ?? '-');
        }
        printf("  %d events.\n", \count($events));

        echo "\n  What this CANNOT tell you\n";
        echo "  ────────────────────────────────────────────────────────────\n";
        echo "  POST /app/layouts/preview rendered template source straight from\n";
        echo "  the request body. It saved nothing and wrote no audit entry, so\n";
        echo "  the highest-risk path leaves NO trace in this database at all.\n";
        echo "  A clean report here is therefore not proof that nothing happened.\n";
        echo "  Web server access logs for POSTs to that route are the only\n";
        echo "  remaining record, and only for as long as they are retained.\n\n";
    })(),

    'cache:clear' => (function () use ($container) {
        $cachePath = $container->get('config.base_path') . '/var/cache';
        if (is_dir($cachePath)) {
            $files = new RecursiveIteratorIterator(
                new RecursiveDirectoryIterator($cachePath, FilesystemIterator::SKIP_DOTS),
                RecursiveIteratorIterator::CHILD_FIRST,
            );
            foreach ($files as $file) {
                $file->isDir() ? rmdir($file->getRealPath()) : unlink($file->getRealPath());
            }
        }
        echo "Cache cleared.\n";
    })(),

    'queue:work' => (function () use ($container) {
        $scanService = $container->get(\OCI\Scanning\Service\ScanService::class);
        $exportJobs = $container->get(\OCI\Identity\Service\AccountExportJobService::class);
        $backupJobs = $container->get(\OCI\Admin\Service\BackupJobService::class);
        $restoreJobs = $container->get(\OCI\Admin\Service\RestoreJobService::class);
        $scriptJobs = $container->get(\OCI\Banner\Service\ScriptRegenerationJobService::class);
        $logger = $container->get(\Psr\Log\LoggerInterface::class);

        echo "Queue worker started. Waiting for jobs...\n";
        $logger->info('Queue worker started');

        // A status file still claiming to be running cannot belong to this
        // process, so it is an interrupted restore. Because RestoreService
        // stages before it swaps, that interruption never touched live data —
        // this reports a clean failure and clears the maintenance lock rather
        // than leaving the app wedged behind it.
        try {
            $restoreJobs->recoverOrphaned();
        } catch (\Throwable $e) {
            $logger->error('Orphaned restore recovery failed: ' . $e->getMessage());
        }

        $idleCount = 0;

        while (true) {
            try {
                // Script regeneration first, and BEFORE the blocking scan pop:
                // a revoked agency's branding must come off a client's site
                // within seconds, not after whatever scan happens to be next.
                // Time-boxed so a bulk template apply cannot starve the rest.
                // queue:work-scripts drains the same lists without the cap.
                $processed = $scriptJobs->drain(10) > 0;

                if ($scanService->processNextScan()) {
                    $processed = true;
                }

                // Self-serve account exports ride the same worker; the scan
                // pop above blocks up to 5s, so exports start within seconds.
                // Restores go first: one is running behind a maintenance lock
                // that holds the whole app, so nothing else should delay it.
                if ($restoreJobs->processNext()) {
                    $processed = true;
                }

                // Backups too. Kept ahead of the idle counter so a queued
                // backup starts on the next tick rather than waiting out the
                // scan pop's blocking timeout.
                if ($backupJobs->processNext()) {
                    $processed = true;
                }

                if ($exportJobs->processNext()) {
                    $processed = true;
                }

                if ($processed) {
                    $idleCount = 0;
                } else {
                    $idleCount++;
                    // Check for stale scans every 60 idle cycles (~5 min with 5s blocking pop)
                    if ($idleCount % 60 === 0) {
                        $scanService->processStaleScans();
                    }
                }
            } catch (\Throwable $e) {
                $logger->error('Queue worker error: ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
                sleep(5);
            }
        }
    })(),

    // A worker for script regeneration alone. queue:work also drains these
    // lists, but a scan can hold that loop for minutes; run this alongside it
    // so branding and template changes reach client sites regardless. Both
    // may run at once — pops are atomic and a duplicate regeneration is
    // harmless.
    'queue:work-scripts' => (function () use ($container) {
        $scriptJobs = $container->get(\OCI\Banner\Service\ScriptRegenerationJobService::class);
        $logger = $container->get(\Psr\Log\LoggerInterface::class);

        echo "Script regeneration worker started. Waiting for jobs...\n";
        $logger->info('Script regeneration worker started');

        while (true) {
            try {
                // Blocks up to 5s across both priority lists, high first.
                $scriptJobs->processBlocking(5);
            } catch (\Throwable $e) {
                $logger->error('Script regeneration worker error: ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
                sleep(5);
            }
        }
    })(),

    'ingest:flush' => (function () use ($container) {
        $flushService = $container->get(\OCI\Scanning\Service\BeaconFlushService::class);
        $logger = $container->get(\Psr\Log\LoggerInterface::class);

        echo "Beacon flush worker started. Processing buffer...\n";
        $logger->info('Beacon flush worker started');

        while (true) {
            try {
                $count = $flushService->flush(200);

                if ($count === 0) {
                    usleep(500_000); // 500ms idle sleep
                }
            } catch (\Throwable $e) {
                $logger->error('Beacon flush error: ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
                sleep(5);
            }
        }
    })(),

    'schedule:run' => (function () use ($container, $moduleScheduledTasks) {
        $scanService = $container->get(\OCI\Scanning\Service\ScanService::class);
        $reportService = $container->get(\OCI\Report\Service\ReportService::class);
        $emailVerifier = $container->get(\OCI\Identity\Service\EmailVerificationService::class);
        $db = $container->get(\Doctrine\DBAL\Connection::class);
        $logger = $container->get(\Psr\Log\LoggerInterface::class);

        // oci_configuration has UNIQUE (scope, scope_id, config_key), but these
        // rows carry scope_id = NULL and MariaDB treats NULLs as distinct in a
        // unique index. ON DUPLICATE KEY UPDATE therefore never matched and
        // inserted another row every time. fetchOne() then kept returning the
        // OLDEST stamp, so the "-23 hours" gate was always satisfied and the job
        // fired on every tick of its window instead of once a day. That is how
        // email_verification_last_run reached 1,184 rows and 24 runs a day since
        // 2026-05-26, each one batching 500 calls against a paid API.
        $stampConfig = static function (string $scope, string $key, string $value) use ($db): void {
            $updated = $db->executeStatement(
                'UPDATE oci_configuration SET config_value = ? WHERE scope = ? AND scope_id IS NULL AND config_key = ?',
                [$value, $scope, $key],
            );

            if ($updated === 0) {
                $db->executeStatement(
                    'INSERT INTO oci_configuration (scope, scope_id, config_key, config_value) VALUES (?, NULL, ?, ?)',
                    [$scope, $key, $value],
                );
            }
        };

        echo "Scheduler started. Checking every 5 minutes...\n";
        $logger->info('Scheduler started');

        while (true) {
            try {
                $scanService->processDueScheduledScans();
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (scans): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            try {
                $reportService->processDueSchedules();
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (reports): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Scan server health poll — pings each active scanner's /health,
            // records heartbeats, and emails an alert on down/recovery (deduped
            // so an outage sends one "down" mail and one "recovered" mail).
            try {
                $health = $container->get(\OCI\Scanning\Service\ServerHealthService::class)->checkAll();
                foreach ($health as $hr) {
                    if ($hr['alerted'] === 'down') {
                        echo "Scan server '{$hr['name']}' is DOWN — alert emailed.\n";
                    } elseif ($hr['alerted'] === 'recovered') {
                        echo "Scan server '{$hr['name']}' recovered — notice emailed.\n";
                    }
                }
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (scan server health): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Public status feed — written every cycle right after the health
            // poll so the getconzent.com status page reflects scanner state.
            // The feed's own freshness doubles as the scheduler heartbeat.
            try {
                $container->get(\OCI\Admin\Service\StatusReportService::class)->write();
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (status feed): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Backup heartbeat — arms itself on the first stamp the host's
            // backup script writes; from then on, a stale stamp alerts.
            try {
                $container->get(\OCI\Admin\Service\BackupFreshnessService::class)->check();
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (backup monitor): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Daily email verification sweep — runs at most once per 23 hours,
            // only between 04:00 and 06:00 (cheap API quota window).
            try {
                $now  = new \DateTimeImmutable();
                $hour = (int) $now->format('G');
                if ($hour >= 4 && $hour < 6) {
                    $last = $db->fetchOne(
                        "SELECT config_value FROM oci_configuration WHERE scope = 'global' AND scope_id IS NULL AND config_key = ?",
                        ['email_verification_last_run'],
                    );
                    $threshold = $now->modify('-23 hours')->format('Y-m-d H:i:s');
                    if (!$last || (string) $last < $threshold) {
                        $logger->info('Running daily email verification sweep');
                        $emailVerifier->runBatch(
                            (int) ($_ENV['EMAIL_VERIFICATION_BATCH_SIZE'] ?? 500),
                            (int) ($_ENV['EMAIL_VERIFICATION_DELAY_MS'] ?? 200),
                        );
                        $stampConfig('global', 'email_verification_last_run', $now->format('Y-m-d H:i:s'));
                    }
                }
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (email verification): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Daily IAB Global Vendor List refresh — runs at most once per 23
            // hours, between 06:00 and 08:00. TCF requires the GVL be kept
            // current; the v2.4 disclosures (standardTexts, Feature
            // illustrations, the renamed Special Feature 2) arrive purely as
            // GVL data and need no script regeneration to take effect.
            try {
                $gvl = $container->get(\OCI\Compliance\Service\GvlUpdateService::class);
                if ($gvl->isEnabled()) {
                    $now  = new \DateTimeImmutable();
                    $hour = (int) $now->format('G');
                    if ($hour >= 6 && $hour < 8) {
                        $last = $db->fetchOne(
                            "SELECT config_value FROM oci_configuration WHERE scope = 'global' AND scope_id IS NULL AND config_key = ?",
                            ['gvl_last_run'],
                        );
                        $threshold = $now->modify('-23 hours')->format('Y-m-d H:i:s');
                        if (!$last || (string) $last < $threshold) {
                            $logger->info('Running daily GVL refresh');
                            $result = $gvl->update();
                            if ($result->updated) {
                                echo "GVL updated: v{$result->previousVersion} → v{$result->newVersion}\n";
                                $gvl->updateTranslations();
                            }
                            foreach ($result->warnings as $warning) {
                                $logger->warning('GVL: ' . $warning);
                            }
                            // Stamp on every attempt, including "already current",
                            // so a healthy no-op doesn't retry every 5 minutes.
                            $stampConfig('global', 'gvl_last_run', $now->format('Y-m-d H:i:s'));
                        }
                    }
                }
            } catch (\Throwable $e) {
                // Validation failures leave the previous list serving untouched.
                $logger->error('Scheduler error (GVL refresh): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Public cookie database pages — rewritten nightly between 04:00
            // and 06:00 so the index, vendor pages and sitemap pick up the
            // day's classifications (single pages refresh on classification).
            // Only on an install that switched it on (global setting
            // `cookie_pages_enabled` = 1): the pages wear one site's shell.
            try {
                $now  = new \DateTimeImmutable();
                $hour = (int) $now->format('G');
                $cookiePages = $container->get(\OCI\Cookie\Service\CookiePageGenerator::class);
                if ($hour >= 4 && $hour < 6 && $cookiePages->isEnabled()) {
                    $last = $db->fetchOne(
                        "SELECT config_value FROM oci_configuration WHERE scope = 'global' AND scope_id IS NULL AND config_key = ?",
                        ['cookie_pages_last_run'],
                    );
                    $threshold = $now->modify('-23 hours')->format('Y-m-d H:i:s');
                    if (!$last || (string) $last < $threshold) {
                        $stats = $cookiePages->publishAll();
                        echo "Cookie pages: {$stats['pages']} cookies, {$stats['vendors']} vendors.\n";
                        $stampConfig('global', 'cookie_pages_last_run', $now->format('Y-m-d H:i:s'));
                    }
                }
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (cookie pages): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Consent-log retention — deletes records older than
            // CONSENT_LOG_RETENTION_DAYS (0 disables). At most once per 23
            // hours, between 02:00 and 04:00; satellites cascade via FK.
            try {
                $retentionDays = (int) ($_ENV['CONSENT_LOG_RETENTION_DAYS'] ?? 1095);
                if ($retentionDays > 0) {
                    $now  = new \DateTimeImmutable();
                    $hour = (int) $now->format('G');
                    if ($hour >= 2 && $hour < 4) {
                        $last = $db->fetchOne(
                            "SELECT config_value FROM oci_configuration WHERE scope = 'global' AND scope_id IS NULL AND config_key = ?",
                            ['consent_purge_last_run'],
                        );
                        $threshold = $now->modify('-23 hours')->format('Y-m-d H:i:s');
                        if (!$last || (string) $last < $threshold) {
                            $purged = $container->get(\OCI\Consent\Repository\ConsentRepositoryInterface::class)
                                ->purgeOlderThan($retentionDays);
                            if ($purged > 0) {
                                $logger->info("Consent retention: purged {$purged} record(s) older than {$retentionDays} days");
                                echo "Consent retention: purged {$purged} record(s).\n";
                            }
                            // Client-event dedupe ledger only needs to outlive
                            // the banner's 30-day offline queue TTL.
                            $ledgerPurged = $container->get(\OCI\Infrastructure\Ingest\ClientEventLedgerInterface::class)
                                ->purgeOlderThan(45);
                            if ($ledgerPurged > 0) {
                                $logger->info("Client event ledger: purged {$ledgerPurged} row(s) older than 45 days");
                            }
                            $stampConfig('global', 'consent_purge_last_run', $now->format('Y-m-d H:i:s'));
                        }
                    }
                }
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (consent retention): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Daily backup. The hour comes from the admin page rather than a
            // constant. Without this block the schedule setting would save and
            // then do nothing, which is precisely the silent lie this whole
            // feature exists to remove.
            try {
                $hourRaw = $db->fetchOne(
                    "SELECT config_value FROM oci_configuration WHERE scope = 'system' AND scope_id IS NULL AND config_key = 'backup_schedule_hour'",
                );

                if (\is_string($hourRaw) && $hourRaw !== '') {
                    $now = new \DateTimeImmutable();

                    if ((int) $now->format('G') === max(0, min(23, (int) $hourRaw))) {
                        $last = $db->fetchOne(
                            "SELECT config_value FROM oci_configuration WHERE scope = 'system' AND scope_id IS NULL AND config_key = 'backup_last_run'",
                        );
                        $threshold = $now->modify('-23 hours')->format('Y-m-d H:i:s');

                        if (!$last || (string) $last < $threshold) {
                            $includeConfig = $db->fetchOne(
                                "SELECT config_value FROM oci_configuration WHERE scope = 'system' AND scope_id IS NULL AND config_key = 'backup_include_config'",
                            ) === '1';

                            $queued = $container->get(\OCI\Admin\Service\BackupJobService::class)
                                ->request('scheduled', $includeConfig);

                            // Only stamp when something was actually queued.
                            // Stamping first would burn the day's slot on a
                            // refusal and skip the backup entirely — and saying
                            // "queued" without checking the return is precisely
                            // the kind of cheerful log line this whole feature
                            // exists to stop trusting. Re-enqueueing on the next
                            // tick is safe: request() refuses while one is live.
                            if ($queued) {
                                $stampConfig('system', 'backup_last_run', $now->format('Y-m-d H:i:s'));
                                $logger->info('Scheduled backup queued', ['hour' => (int) $hourRaw]);
                                echo "Scheduled backup queued.\n";
                            } else {
                                $logger->warning('Scheduled backup NOT queued - another backup is still in flight');
                                echo "Scheduled backup skipped: one is already running.\n";
                            }
                        }
                    }
                }
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (backup): ' . $e->getMessage());
                echo "Error: {$e->getMessage()}\n";
            }

            // Retention. After the backup above, so a fresh archive is already
            // in the count, and never below the configured keep.
            try {
                $keep = $container->get(\OCI\Admin\Service\BackupOverviewService::class)->retention();
                $container->get(\OCI\Admin\Service\BackupRetentionService::class)->prune($keep);
            } catch (\Throwable $e) {
                $logger->error('Scheduler error (backup retention): ' . $e->getMessage());
            }

            // Module-contributed periodic tasks (Cloud Edition) — e.g. AutoSEO
            // article translations. Registered via each module's config/scheduled.php
            // so this core scheduler references no module class. Each runs every
            // cycle (tasks are expected to be cheap no-ops when there's nothing to do).
            foreach ($moduleScheduledTasks as $taskName => $task) {
                try {
                    if (\is_callable($task)) {
                        $task($container);
                    }
                } catch (\Throwable $e) {
                    $logger->error("Scheduler error ({$taskName}): " . $e->getMessage());
                    echo "Error: {$e->getMessage()}\n";
                }
            }

            sleep(300); // Check every 5 minutes
        }
    })(),

    'scanner:register' => (function () use ($container, $argv) {
        $scanRepo = $container->get(\OCI\Scanning\Repository\ScanRepositoryInterface::class);

        // Defaults target the in-compose scanner. The internal Docker DNS name
        // is always reachable from the app/worker/scheduler containers.
        $url    = trim((string) ($_ENV['SCANNER_URL'] ?? 'http://scanner:8300'));
        $key    = (string) ($_ENV['SCANNER_API_KEY'] ?? '');
        $name   = 'Default Scanner';
        $region = null;
        $max    = (int) ($_ENV['SCANNER_MAX_CONCURRENT'] ?? 5);

        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--url='))    { $url = substr($arg, 6); }
            if (str_starts_with($arg, '--key='))    { $key = substr($arg, 6); }
            if (str_starts_with($arg, '--name='))   { $name = substr($arg, 7); }
            if (str_starts_with($arg, '--region=')) { $region = substr($arg, 9); }
            if (str_starts_with($arg, '--max='))    { $max = (int) substr($arg, 6); }
        }

        $url = rtrim($url, '/');
        if ($url === '') {
            echo "ERROR: --url is required (or set SCANNER_URL).\n";
            exit(1);
        }

        // Idempotent upsert keyed by URL.
        $existing = null;
        foreach ($scanRepo->getAllScanServers() as $s) {
            if (rtrim((string) $s['server_url'], '/') === $url) {
                $existing = $s;
                break;
            }
        }

        if ($existing !== null) {
            $scanRepo->updateScanServer((int) $existing['id'], [
                'server_name'    => $name,
                'api_key'        => $key !== '' ? $key : ($existing['api_key'] ?? null),
                'region'         => $region,
                'max_concurrent' => $max,
                'is_active'      => 1,
            ]);
            echo "Updated scan server #{$existing['id']}: {$name} -> {$url}\n";
        } else {
            $newId = $scanRepo->createScanServer([
                'server_name'    => $name,
                'server_url'     => $url,
                'api_key'        => $key !== '' ? $key : null,
                'region'         => $region,
                'is_active'      => 1,
                'max_concurrent' => $max,
                'current_load'   => 0,
            ]);
            echo "Registered scan server #{$newId}: {$name} -> {$url}\n";
        }

        if ($key === '') {
            echo "  NOTE: no API key set (SCANNER_API_KEY empty). Health checks still\n";
            echo "        work, but scan dispatch fails if the scanner requires a key.\n";
        }
        echo "Run 'php bin/oci scanner:health' to verify.\n";
    })(),

    'scanner:health' => (function () use ($container) {
        $svc = $container->get(\OCI\Scanning\Service\ServerHealthService::class);
        $results = $svc->checkAll();

        if ($results === []) {
            echo "No active scan servers registered.\n";
            echo "Register the in-compose scanner with: php bin/oci scanner:register\n";
            return;
        }

        printf("%-4s %-22s %-30s %-9s %s\n", 'ID', 'NAME', 'URL', 'STATUS', 'NOTE');
        echo str_repeat('-', 92) . "\n";
        foreach ($results as $r) {
            $status = $r['healthy'] ? 'healthy' : 'OFFLINE';
            $note   = $r['healthy'] ? '' : ('http=' . $r['http_code'] . ' ' . $r['error']);
            if ($r['alerted'] === 'down')      { $note .= '  [DOWN alert emailed]'; }
            if ($r['alerted'] === 'recovered') { $note  = '[recovery email sent]'; }
            printf(
                "%-4d %-22s %-30s %-9s %s\n",
                $r['id'],
                substr($r['name'], 0, 22),
                substr($r['url'], 0, 30),
                $status,
                $note,
            );
        }
    })(),

    'migrations:migrate' => (function () use ($container) {
        echo "Running OCI migrations...\n";

        $db = $container->get(\Doctrine\DBAL\Connection::class);

        // Ensure tracking table exists
        $db->executeStatement('
            CREATE TABLE IF NOT EXISTS oci_migration_versions (
                version VARCHAR(255) NOT NULL PRIMARY KEY,
                executed_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
            ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
        ');

        // Discover migration files
        $migrationsDir = dirname(__DIR__) . '/migrations/versions';
        $files = glob($migrationsDir . '/Version*.php');
        sort($files);

        if (empty($files)) {
            echo "No migration files found in {$migrationsDir}\n";
            return;
        }

        // Already executed
        $executed = $db->fetchFirstColumn('SELECT version FROM oci_migration_versions ORDER BY version');
        $executedMap = array_flip($executed);

        $pending = [];
        foreach ($files as $file) {
            $className = 'OCI\\Database\\Migrations\\' . pathinfo($file, PATHINFO_FILENAME);
            if (!isset($executedMap[$className])) {
                $pending[$className] = $file;
            }
        }

        if (empty($pending)) {
            echo "No new migrations to run. (" . \count($executed) . " already executed)\n";
            return;
        }

        echo \count($pending) . " new migration(s) to execute.\n\n";

        foreach ($pending as $className => $file) {
            require_once $file;

            if (!class_exists($className)) {
                echo "  SKIP: Class {$className} not found in {$file}\n";
                continue;
            }

            $shortName = pathinfo($file, PATHINFO_FILENAME);
            echo "  ▸ {$shortName}...";

            try {
                $migration = new $className($db);
                $migration->up();

                $db->insert('oci_migration_versions', [
                    'version' => $className,
                    'executed_at' => date('Y-m-d H:i:s'),
                ]);

                echo " ✓\n";
            } catch (\Throwable $e) {
                echo " ✗ {$e->getMessage()}\n";
                exit(1);
            }
        }

        echo "\nMigrations completed successfully.\n";
    })(),

    /**
     * Repairs sites suspended for a billing reason under a customer who is
     * demonstrably paying. Site status and subscription state are written by
     * different events (webhooks, the EUR migration, the v1 importer), and a
     * cancellation event arriving after its replacement subscription started
     * could leave a site suspended while its owner had a live trialing
     * subscription; a suspended site regenerates as an empty script.js, so
     * the banner went away.
     *
     * The webhook no longer does that. This command cleans up after the ones
     * that already did, and only ever in the safe direction: it activates,
     * never suspends, and only where a live subscription says it may.
     */
    'billing:resync-sites' => (function () use ($container, $argv) {
        $db = $container->get(\Doctrine\DBAL\Connection::class);
        $gen = $container->get(\OCI\Banner\Service\ScriptGenerationService::class);

        $apply = \in_array('--apply', $argv, true);
        $userArg = null;
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--user=')) { $userArg = substr($arg, 7); }
        }

        $schema = $db->createSchemaManager();
        if (!$schema->tablesExist(['oci_subscriptions'])) {
            echo "No subscriptions table in this installation; nothing to resync.\n";
            return;
        }

        $where = '';
        $params = [];
        if ($userArg !== null && $userArg !== '') {
            $userId = ctype_digit($userArg)
                ? (int) $userArg
                : (int) $db->fetchOne('SELECT id FROM oci_users WHERE LOWER(email) = ?', [strtolower(trim($userArg))]);
            if ($userId <= 0) {
                echo "No such user: {$userArg}\n";
                return;
            }
            $where = ' AND s.user_id = ?';
            $params[] = $userId;
        }

        $rows = $db->fetchAllAssociative(
            "SELECT s.id, s.user_id, s.domain, s.website_key, s.suspended_reason, u.email,
                    sub.status AS sub_status, sub.plan_key, sub.quantity
             FROM oci_sites s
             JOIN oci_users u ON u.id = s.user_id
             JOIN oci_subscriptions sub ON sub.user_id = s.user_id AND sub.status IN ('active', 'trialing')
             WHERE s.status = 'suspended'
               AND s.suspended_reason IN ('subscription_ended', 'no_subscription', 'plan_limit')
               AND s.deleted_at IS NULL" . $where . '
             ORDER BY s.user_id, s.id',
            $params,
        );

        if ($rows === []) {
            echo "Nothing to do: every suspended site belongs to a customer with no live subscription.\n";
            return;
        }

        // A customer's allowance still caps how many come back, oldest first.
        $byUser = [];
        foreach ($rows as $row) {
            $byUser[(int) $row['user_id']][] = $row;
        }

        $activated = [];
        foreach ($byUser as $userId => $sites) {
            $allowance = max(1, (int) ($sites[0]['quantity'] ?? 1));
            $activeAlready = (int) $db->fetchOne(
                "SELECT COUNT(*) FROM oci_sites WHERE user_id = ? AND status = 'active' AND deleted_at IS NULL",
                [$userId],
            );
            $room = max(0, $allowance - $activeAlready);

            echo "{$sites[0]['email']} — {$sites[0]['sub_status']} {$sites[0]['plan_key']}, "
                . "allowance {$allowance}, {$activeAlready} active, " . \count($sites) . " suspended\n";

            foreach ($sites as $i => $site) {
                $siteId = (int) $site['id'];
                if ($i >= $room) {
                    echo "  · {$site['domain']} stays suspended (over the plan allowance)\n";
                    continue;
                }
                echo ($apply ? '  ▸ ' : '  would activate ') . "{$site['domain']} ({$site['suspended_reason']}, key {$site['website_key']})";
                if (!$apply) { echo "\n"; continue; }

                $db->executeStatement(
                    "UPDATE oci_sites SET status = 'active', suspended_reason = NULL, updated_at = NOW() WHERE id = ?",
                    [$siteId],
                );
                try {
                    $gen->generate($siteId);
                    $path = \dirname(__DIR__) . '/public/sites_data/' . $site['website_key'] . '/script.js';
                    $size = is_file($path) ? (int) filesize($path) : 0;
                    echo $size > 0 ? " ✓ script " . number_format($size) . " bytes\n" : " ✗ script is still empty\n";
                } catch (\Throwable $e) {
                    echo " ✗ {$e->getMessage()}\n";
                }
                $activated[] = $siteId;
            }
        }

        echo $apply
            ? "\nActivated " . \count($activated) . " site(s). Scripts regenerated.\n"
            : "\nDry run. Add --apply to activate these sites and regenerate their scripts.\n";
    })(),

    // Fill the status page's history with the planned updates that already
    // happened. Each deployment took the service away for a couple of minutes
    // by design; that is listed as an update, never as downtime.
    //
    //   php bin/oci status:backfill-updates <deployments.json> [--minutes=4] [--apply]
    //
    // The file is a JSON array of {"at": "2026-09-18T09:16:25Z", "ref": "<id>",
    // "summary": "..."} — `ref` makes a re-run update rather than duplicate.
    'status:backfill-updates' => (function () use ($container, $argv) {
        $file = null;
        $minutes = 4;
        $apply = false;
        foreach (\array_slice($argv, 2) as $arg) {
            if ($arg === '--apply') {
                $apply = true;
            } elseif (str_starts_with($arg, '--minutes=')) {
                $minutes = max(1, (int) substr($arg, 10));
            } elseif (!str_starts_with($arg, '--')) {
                $file = $arg;
            }
        }

        if ($file === null || !is_file($file)) {
            echo "Usage: php bin/oci status:backfill-updates <deployments.json> [--minutes=4] [--apply]\n";

            return;
        }

        $entries = json_decode((string) file_get_contents($file), true);
        if (!\is_array($entries)) {
            echo "Cannot read {$file} as JSON.\n";

            return;
        }

        $history = $container->get(\OCI\Admin\Service\StatusHistoryService::class);
        $written = 0;
        foreach ($entries as $entry) {
            $at = strtotime((string) ($entry['at'] ?? ''));
            if ($at === false) {
                continue;
            }
            $started = date('Y-m-d H:i:s', $at);
            $ended = date('Y-m-d H:i:s', $at + ($minutes * 60));
            $summary = (string) ($entry['summary'] ?? 'Planned update');

            echo str_pad($started, 22), $minutes, " min  ", $summary, "\n";

            if ($apply) {
                $history->recordIncident(
                    $started,
                    $ended,
                    \OCI\Admin\Service\StatusHistoryService::KIND_UPDATE,
                    $summary,
                    'Estimated from the deployment record. New versions roll out without taking the service down for longer than this.',
                    null,
                    'deployment',
                    (string) ($entry['ref'] ?? $started),
                );
                $written++;
            }
        }

        echo $apply
            ? "\nRecorded {$written} planned update(s).\n"
            : "\nDry run. Add --apply to record these.\n";
    })(),

