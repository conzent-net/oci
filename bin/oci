    'cookies:translate' => (function () use ($container, $argv) {
        $generate = \in_array('--generate', $argv, true);
        $insert = \in_array('--insert', $argv, true);
        $dryRun = \in_array('--dry-run', $argv, true);
        $force = \in_array('--force', $argv, true);
        $lang = null;
        $delay = 2;

        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--lang=')) {
                $lang = substr($arg, 7);
            }
            if (str_starts_with($arg, '--delay=')) {
                $delay = (int) substr($arg, 8);
            }
        }

        if (!$generate && !$insert) {
            echo "Usage: php bin/oci cookies:translate [options]\n\n";
            echo "Translates cookie descriptions from oci_cookies_global into all languages.\n\n";
            echo "Options:\n";
            echo "  --generate          Translate via AI and write to cache file\n";
            echo "  --insert            Read cache file and upsert into database\n";
            echo "  --lang=XX           Process only one language code (e.g., --lang=da)\n";
            echo "  --delay=N           Seconds between API calls (default: 2)\n";
            echo "  --force             Re-translate even if cached\n";
            echo "  --dry-run           Show what would happen without writing\n";
            return;
        }

        $db = $container->get(\Doctrine\DBAL\Connection::class);
        $ai = $container->get(\OCI\Infrastructure\Ai\AiClientInterface::class);
        $logger = $container->get(\Psr\Log\LoggerInterface::class);
        $basePath = $container->get('config.base_path');

        $seeder = new \OCI\Cookie\Service\CookieTranslationSeeder($db, $ai, $logger, $basePath);

        echo "╔══════════════════════════════════════════╗\n";
        echo "║   Cookie Description Translator           ║\n";
        echo "╚══════════════════════════════════════════╝\n\n";

        if ($dryRun) {
            echo "  DRY RUN — no changes will be written.\n\n";
        }

        // --- Phase 1: Generate translations via AI ---
        if ($generate) {
            $cookies = $seeder->getTranslatableCookies();
            echo "Translatable cookies: " . \count($cookies) . "\n\n";

            if (empty($cookies)) {
                echo "No cookies with descriptions found. Run 'cookies:sync' first.\n";
                return;
            }

            $seeder->generateTranslations(
                singleLang: $lang,
                force: $force,
                delaySeconds: $dryRun ? 0 : $delay,
                onProgress: \Closure::fromCallable(function (string $code, string $name, string $status) {
                    echo "  {$name} ({$code}) — {$status}\n";
                }),
            );

            echo "\nCache file written: resources/data/cookie-global-translations.php\n\n";
        }

        // --- Phase 2: Insert into database ---
        if ($insert) {
            $cached = $seeder->loadCachedTranslations();

            if (empty($cached)) {
                echo "ERROR: No cached translations found. Run with --generate first.\n";
                exit(1);
            }

            // The translations key on oci_cookies_global ids — a fresh install
            // has none until the reference database is pulled.
            $globalCount = (int) $container->get(\Doctrine\DBAL\Connection::class)
                ->fetchOne('SELECT COUNT(*) FROM oci_cookies_global');
            if ($globalCount === 0) {
                echo "ERROR: oci_cookies_global is empty. Run 'php bin/oci cookies:sync' first.\n";
                exit(1);
            }

            if ($lang !== null) {
                $cached = array_filter($cached, fn($code) => $code === $lang, ARRAY_FILTER_USE_KEY);
            }

            $totalEntries = 0;
            foreach ($cached as $cookies) {
                $totalEntries += \count($cookies);
            }

            echo "Inserting {$totalEntries} translations (" . \count($cached) . " languages) into oci_cookies_global_translations...\n";

            $stats = $seeder->insertIntoDatabase($cached, $dryRun);

            echo "  Inserted: {$stats['inserted']}\n";
            echo "  Updated:  {$stats['updated']}\n";
            echo "  Skipped:  {$stats['skipped']}\n\n";
        }

        echo "Done.\n";
    })(),

