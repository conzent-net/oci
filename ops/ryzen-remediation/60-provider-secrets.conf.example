# Copy to /root/conzent-provider-rotation.secret.conf, chmod 0600, and replace
# every placeholder for each credential that is currently active. Create new
# provider credentials first; revoke the old credentials only after deployment
# and verification succeed.
APP_SECRET=<NEW_RANDOM_64_HEX>
ADMIN_OVERRIDE_PASSWORD=<NEW_RANDOM_PASSWORD_IF_USED>
APICLOUD_GENERAL_API_KEY=<NEW_APICLOUD_GENERAL_KEY_IF_USED>
APICLOUD_CRAWLER_API_KEY=<NEW_APICLOUD_CRAWLER_KEY_IF_USED>
AUTOSEO_WEBHOOK_TOKEN=<NEW_RANDOM_TOKEN_IF_USED>
CLOUDFLARE_API_TOKEN=<NEW_CLOUDFLARE_TOKEN_IF_USED>
ENDPOINTR_API_KEY=<NEW_ENDPOINTR_KEY_IF_USED>
FRESHDESK_API_KEY=<NEW_FRESHDESK_KEY_IF_USED>
GOOGLE_CLIENT_SECRET=<NEW_GOOGLE_SECRET_IF_USED>
GOOGLE_ADS_CLIENT_SECRET=<NEW_GOOGLE_ADS_SECRET_IF_USED>
IPREGISTRY_API_KEY=<NEW_IPREGISTRY_KEY_IF_USED>
LEGACY_AUTOLOGIN_API_KEY=<NEW_RANDOM_LEGACY_AUTOLOGIN_KEY_IF_USED>
MAIL_USERNAME=<NEW_SES_SMTP_USERNAME_IF_USED>
MAIL_PASSWORD=<NEW_SES_SMTP_PASSWORD_IF_USED>
META_APP_SECRET=<NEW_META_SECRET_IF_USED>
MISSIVE_API_TOKEN=<NEW_MISSIVE_TOKEN_IF_USED>
MISSIVE_WEBHOOK_SECRET=<NEW_MISSIVE_WEBHOOK_SECRET_IF_USED>
OPENROUTER_API_KEY=<NEW_OPENROUTER_KEY_IF_USED>
SCANNER_API_KEY=<NEW_RANDOM_SCANNER_KEY>
SCANNER_WEBHOOK_SECRET=<NEW_RANDOM_WEBHOOK_SECRET_IF_USED>
SENDMAIL_API_KEY=<NEW_SENDMAIL_KEY_IF_USED>
SPARKPOST_SMTP_USERNAME=<NEW_SPARKPOST_USERNAME_IF_USED>
SPARKPOST_SMTP_PASSWORD=<NEW_SPARKPOST_PASSWORD_IF_USED>
STRIPE_TEST_SECRET_KEY=<NEW_STRIPE_TEST_KEY_IF_USED>
STRIPE_TEST_WEBHOOK_SECRET=<NEW_STRIPE_TEST_WEBHOOK_SECRET_IF_USED>
STRIPE_LIVE_SECRET_KEY=<NEW_STRIPE_LIVE_KEY_IF_USED>
STRIPE_LIVE_WEBHOOK_SECRET=<NEW_STRIPE_LIVE_WEBHOOK_SECRET_IF_USED>
WIX_APP_SECRET=<NEW_WIX_SECRET_IF_USED>
