{
  "name": "@getconzent/consent",
  "version": "0.1.1",
  "description": "Typed loader, React hook and Next.js component for the Conzent consent management platform",
  "license": "Apache-2.0",
  "homepage": "https://getconzent.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/conzent-net/oci.git",
    "directory": "sdk"
  },
  "keywords": ["consent", "cmp", "gdpr", "cookie-banner", "consent-mode", "tcf", "conzent"],
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm run build && node --test \"test/**/*.test.mjs\""
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
