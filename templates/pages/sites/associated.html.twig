{% extends 'layouts/base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div x-data="associatedDomainsPage()">

    <nav class="breadcrumb mb-3" aria-label="breadcrumbs">
        <ul>
            <li><a href="/">Dashboard</a></li>
            <li class="is-active"><a href="#" aria-current="page">Associated Domains</a></li>
        </ul>
    </nav>

    {# ── Header ────────────────────────────────────────── #}
    <div class="level mb-4">
        <div class="level-left">
            <div class="level-item">
                <h1 class="title is-4 mb-0">Associated Domains</h1>
            </div>
            <div class="level-item">
                <span class="tag is-info is-light is-medium">
                    {{ currentSite.domain }}
                </span>
            </div>
        </div>
        <div class="level-right">
            <div class="level-item">
                <button class="button is-primary" @click="addModal = true">
                    <span class="icon"><i class="fas fa-plus"></i></span>
                    <span>Add Domain</span>
                </button>
            </div>
        </div>
    </div>

    <div class="notification is-info is-light">
        An associated domain is an alias that shares this site's banner, cookie list and consent
        configuration — for example a second market domain serving the same site. Subdomains of
        <strong>{{ currentSite.domain }}</strong> are covered automatically and don't need an entry here.
        Consent is stored per domain; browsers do not allow sharing it across different domains.
    </div>

    {# ── Associated Domains Table ─────────────────────── #}
    {% if associatedDomains is empty %}
        <div class="box has-text-centered py-6">
            <span class="icon is-large has-text-grey-light">
                <i class="fas fa-globe fa-3x"></i>
            </span>
            <p class="title is-5 mt-4">No associated domains</p>
            <p class="subtitle is-6 has-text-grey">The banner only loads on {{ currentSite.domain }} and its subdomains.</p>
        </div>
    {% else %}
    <div class="table-container">
        <table class="table is-fullwidth is-hoverable">
            <thead>
                <tr>
                    <th>Domain</th>
                    <th>Privacy Policy URL</th>
                    <th>Added</th>
                    <th class="has-text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for assoc in associatedDomains %}
                <tr>
                    <td class="has-text-weight-semibold">{{ assoc.domain }}</td>
                    <td>
                        {% if assoc.privacy_policy_url %}
                            <a href="{{ assoc.privacy_policy_url }}" target="_blank" rel="noopener" class="is-size-7">{{ assoc.privacy_policy_url }}</a>
                        {% else %}
                            <span class="has-text-grey-light">—</span>
                        {% endif %}
                    </td>
                    <td class="is-size-7 has-text-grey">{{ assoc.created_at|date('Y-m-d') }}</td>
                    <td class="has-text-right">
                        <button class="button is-small is-danger is-light"
                                @click="confirmRemove({{ assoc.id }}, '{{ assoc.domain|e('js') }}')">
                            <span class="icon"><i class="fas fa-trash"></i></span>
                        </button>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}

    {# ── Add Domain Modal ─────────────────────────────── #}
    <div class="modal" :class="{ 'is-active': addModal }">
        <div class="modal-background" @click="addModal = false"></div>
        <div class="modal-card" style="max-width:480px">
            <header class="modal-card-head">
                <p class="modal-card-title">Add Associated Domain</p>
                <button class="delete" aria-label="close" @click="addModal = false"></button>
            </header>
            <section class="modal-card-body">
                <div class="field">
                    <label class="label">Domain <span class="has-text-danger">*</span></label>
                    <div class="control">
                        <input class="input" type="text" x-model="form.domain" placeholder="example.se">
                    </div>
                    <p class="help">Just the hostname — no https:// and no path.</p>
                </div>
                <div class="field">
                    <label class="label">Privacy Policy URL</label>
                    <div class="control">
                        <input class="input" type="url" x-model="form.privacy_policy_url" placeholder="https://example.se/privacy">
                    </div>
                    <p class="help">Optional. Shown in the banner when it loads on this domain.</p>
                </div>
                <div class="notification is-warning is-light" x-show="error" x-text="error"></div>
            </section>
            <footer class="modal-card-foot">
                <button class="button is-primary" :class="{ 'is-loading': saving }"
                        :disabled="!form.domain.trim()"
                        @click="addDomain()">Add Domain</button>
                <button class="button" @click="addModal = false">Cancel</button>
            </footer>
        </div>
    </div>

    {# ── Remove Confirmation Modal ────────────────────── #}
    <div class="modal" :class="{ 'is-active': removeModal.open }">
        <div class="modal-background" @click="removeModal.open = false"></div>
        <div class="modal-card" style="max-width:440px">
            <header class="modal-card-head">
                <p class="modal-card-title">Remove Associated Domain</p>
                <button class="delete" aria-label="close" @click="removeModal.open = false"></button>
            </header>
            <section class="modal-card-body">
                <p>Remove <strong x-text="removeModal.domain"></strong> from this site?</p>
                <p class="has-text-grey mt-2">The banner will stop loading on that domain as soon as the script regenerates.</p>
            </section>
            <footer class="modal-card-foot">
                <button class="button is-danger" :class="{ 'is-loading': saving }"
                        @click="removeDomain()">Remove</button>
                <button class="button" @click="removeModal.open = false">Cancel</button>
            </footer>
        </div>
    </div>

</div>
{% endblock %}

{% block scripts %}
<script>
function associatedDomainsPage() {
    return {
        addModal: false,
        saving: false,
        error: '',
        form: { domain: '', privacy_policy_url: '' },
        removeModal: { open: false, id: 0, domain: '' },

        addDomain() {
            if (!this.form.domain.trim()) return;
            this.error = '';
            this.saving = true;
            fetch('/app/sites/associated/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    site_id: {{ siteId }},
                    domain: this.form.domain,
                    privacy_policy_url: this.form.privacy_policy_url
                })
            })
            .then(r => r.json())
            .then(data => {
                this.saving = false;
                if (data.success) {
                    if (data.warning) ocMessage(data.warning);
                    window.location.reload();
                } else {
                    this.error = data.error || 'Failed to add domain';
                }
            })
            .catch(() => { this.saving = false; this.error = 'Network error'; });
        },

        confirmRemove(id, domain) {
            this.removeModal = { open: true, id, domain };
        },

        removeDomain() {
            this.saving = true;
            fetch('/app/sites/associated/remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ site_id: {{ siteId }}, id: this.removeModal.id })
            })
            .then(r => r.json())
            .then(data => {
                this.saving = false;
                if (data.success) {
                    if (data.warning) ocMessage(data.warning);
                    window.location.reload();
                }
            })
            .catch(() => { this.saving = false; });
        }
    };
}
</script>
{% endblock %}
