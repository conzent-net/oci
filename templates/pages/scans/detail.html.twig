{% extends 'layouts/base.html.twig' %}

{% set active_page = 'scans' %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div>
    <nav class="breadcrumb mb-3" aria-label="breadcrumbs">
        <ul>
            <li><a href="/">Dashboard</a></li>
            <li><a href="/scans?site_id={{ siteId }}">Cookie Scans</a></li>
            <li class="is-active"><a href="#" aria-current="page">Scan #{{ scanId }}</a></li>
        </ul>
    </nav>

    {# ── Header ────────────────────────────────────────── #}
    <div class="level mb-4">
        <div class="level-left">
            <div class="level-item">
                <h1 class="title is-4 mb-0">Scan #{{ scanId }}</h1>
            </div>
            <div class="level-item">
                {% if scan.scan_status == 'completed' %}
                    <span class="tag is-success is-light"><i class="fas fa-check mr-1"></i> Completed</span>
                {% elseif scan.scan_status == 'in_progress' %}
                    <span class="tag is-info is-light"><i class="fas fa-spinner fa-spin mr-1"></i> In Progress</span>
                {% elseif scan.scan_status == 'failed' %}
                    <span class="tag is-danger is-light"><i class="fas fa-times mr-1"></i> Failed</span>
                {% else %}
                    <span class="tag is-light">{{ scan.scan_status }}</span>
                {% endif %}
            </div>
        </div>
        <div class="level-right">
            <div class="level-item">
                <a href="/scans?site_id={{ siteId }}" class="button is-light">
                    <span class="icon"><i class="fas fa-arrow-left"></i></span>
                    <span>Back to Scans</span>
                </a>
            </div>
        </div>
    </div>

    {# ── Summary Stats ─────────────────────────────────── #}
    <div class="columns mb-5">
        <div class="column">
            <div class="box has-background-light p-4 has-text-centered">
                <p class="heading">Cookies Found</p>
                <p class="title is-3">{{ stats.total_cookies }}</p>
            </div>
        </div>
        <div class="column">
            <div class="box has-background-light p-4 has-text-centered">
                <p class="heading">Beacons / Scripts</p>
                <p class="title is-3">{{ stats.total_beacons }}</p>
            </div>
        </div>
        <div class="column">
            <div class="box has-background-light p-4 has-text-centered">
                <p class="heading">Categories</p>
                <p class="title is-3">{{ cookiesByCategory|length }}</p>
            </div>
        </div>
    </div>

    {# ── Scan Info ─────────────────────────────────────── #}
    <div class="columns">
        <div class="column is-6">
            <div class="box">
                <h3 class="title is-5 mb-3">Scan Details</h3>
                <table class="table is-narrow is-fullwidth">
                    <tr><th style="width:40%">Site</th><td>{{ site.domain }}</td></tr>
                    <tr><th>Started</th><td>{{ scan.started_at ? scan.started_at|date('Y-m-d H:i:s') : '—' }}</td></tr>
                    <tr><th>Completed</th><td>{{ scan.completed_at ? scan.completed_at|date('Y-m-d H:i:s') : '—' }}</td></tr>
                    <tr><th>Attempts</th><td>{{ scan.scan_attempts }}</td></tr>
                </table>
            </div>
        </div>

        {# ── Cookies by Category ───────────────────────── #}
        <div class="column is-6">
            <div class="box">
                <h3 class="title is-5 mb-3">By Category</h3>
                {% if cookiesByCategory|length > 0 %}
                    {% for category, catCookies in cookiesByCategory %}
                    <div class="level mb-2">
                        <div class="level-left">
                            <span class="tag
                                {% if category == 'necessary' %}is-success
                                {% elseif category == 'functional' %}is-info
                                {% elseif category == 'analytics' %}is-warning
                                {% elseif category == 'marketing' %}is-danger
                                {% else %}is-light
                                {% endif %} is-light">
                                {{ category|capitalize }}
                            </span>
                        </div>
                        <div class="level-right">
                            <strong>{{ catCookies|length }}</strong>
                        </div>
                    </div>
                    {% endfor %}
                {% else %}
                    <p class="has-text-grey">No cookies detected</p>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Cookies Table ─────────────────────────────────── #}
    {% if cookies|length > 0 %}
    <div class="box">
        <h3 class="title is-5 mb-3">Detected Cookies ({{ cookies|length }})</h3>
        <div class="table-container">
            <table class="table is-fullwidth is-hoverable is-striped is-narrow">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Domain</th>
                        <th>Category</th>
                        <th>Expiry</th>
                        <th>HttpOnly</th>
                        <th>Secure</th>
                        <th>SameSite</th>
                    </tr>
                </thead>
                <tbody>
                    {% for cookie in cookies %}
                    <tr>
                        <td><code class="is-size-7">{{ cookie.cookie_name }}</code></td>
                        <td class="is-size-7">{{ cookie.cookie_domain|default('—') }}</td>
                        <td>
                            {% set cat = cookie.category_slug|default('unclassified') %}
                            <span class="tag is-small
                                {% if cat == 'necessary' %}is-success
                                {% elseif cat == 'functional' %}is-info
                                {% elseif cat == 'analytics' %}is-warning
                                {% elseif cat == 'marketing' %}is-danger
                                {% else %}is-light
                                {% endif %} is-light">
                                {{ cat|capitalize }}
                            </span>
                        </td>
                        <td class="is-size-7">{{ cookie.expiry_duration|default('session') }}</td>
                        <td>
                            {% if cookie.http_only %}
                                <span class="icon has-text-success is-small"><i class="fas fa-check"></i></span>
                            {% else %}
                                <span class="icon has-text-grey-lighter is-small"><i class="fas fa-minus"></i></span>
                            {% endif %}
                        </td>
                        <td>
                            {% if cookie.secure %}
                                <span class="icon has-text-success is-small"><i class="fas fa-check"></i></span>
                            {% else %}
                                <span class="icon has-text-grey-lighter is-small"><i class="fas fa-minus"></i></span>
                            {% endif %}
                        </td>
                        <td class="is-size-7">{{ cookie.same_site|default('—') }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {# ── Beacons / Third-Party Scripts ─────────────────── #}
    {% if beacons|length > 0 %}
    <div class="box" x-data="beaconClassifier()">
        <h3 class="title is-5 mb-3">Third-Party Scripts & Beacons ({{ beacons|length }})</h3>
        <div class="table-container">
            <table class="table is-fullwidth is-hoverable is-striped is-narrow">
                <thead>
                    <tr>
                        <th>URL / Domain</th>
                        <th>Type</th>
                        <th>First Seen</th>
                        <th class="has-text-right">Classification</th>
                    </tr>
                </thead>
                <tbody>
                    {% for beacon in beacons %}
                    {% set slug = beacon.resolved_slug|default('unclassified') %}
                    <tr>
                        <td class="is-size-7" style="word-break: break-all;">{{ beacon.beacon_url }}</td>
                        <td>
                            <span class="tag is-small
                                {% if slug == 'necessary' %}is-success is-light
                                {% elseif slug == 'functional' %}is-info is-light
                                {% elseif slug == 'analytics' %}is-warning is-light
                                {% elseif slug == 'marketing' %}is-danger is-light
                                {% else %}is-light
                                {% endif %}">{{ beacon.resolved_name|default('Unclassified') }}</span>
                        </td>
                        <td class="is-size-7">{{ beacon.found_at|date('M j H:i') }}</td>
                        <td class="has-text-right">
                            {% if beacon.is_global %}
                                {% if beacon.domain in pendingBeaconDomains %}
                                    <span class="tag is-small is-warning is-light" title="A reclassification request is awaiting Conzent review">
                                        <span class="icon is-small"><i class="fas fa-clock"></i></span>
                                        <span>Change requested</span>
                                    </span>
                                {% else %}
                                    <button class="button is-small is-light"
                                            @click="openReclassify('{{ beacon.domain|e('js') }}', '{{ slug|e('js') }}', '{{ beacon.resolved_name|default('')|e('js') }}')">
                                        <span class="icon is-small"><i class="fas fa-arrows-turn-right"></i></span>
                                        <span>Request change</span>
                                    </button>
                                {% endif %}
                            {% else %}
                                <button class="button is-small is-primary is-light"
                                        @click="openClassify({{ beacon.id }}, '{{ beacon.domain|e('js') }}')">
                                    <span class="icon is-small"><i class="fas fa-tags"></i></span>
                                    <span>Classify</span>
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# -- Classify modal (unclassified beacons) -- #}
        <div class="modal" :class="{ 'is-active': classifyModal }">
            <div class="modal-background" @click="classifyModal = false"></div>
            <div class="modal-card">
                <header class="modal-card-head">
                    <p class="modal-card-title">Classify beacon</p>
                    <button class="delete" @click="classifyModal = false"></button>
                </header>
                <section class="modal-card-body">
                    <p class="mb-4">Assign <code x-text="classifyForm.domain"></code> to a category. This applies to your site immediately.</p>
                    <div class="field">
                        <label class="label">Category <span class="has-text-danger">*</span></label>
                        <div class="control">
                            <div class="select is-fullwidth">
                                <select x-model="classifyForm.category_id">
                                    <option value="">Select a category...</option>
                                    {% for c in beaconCategoryOptions|filter(c => c.slug != 'unclassified') %}
                                    <option value="{{ c.id }}">{{ c.name|default(c.slug|capitalize) }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="notification is-warning is-light" x-show="classifyError" x-text="classifyError"></div>
                </section>
                <footer class="modal-card-foot">
                    <button class="button is-primary" @click="submitClassify()" :class="{ 'is-loading': classifySubmitting }">
                        <span class="icon"><i class="fas fa-check"></i></span><span>Classify</span>
                    </button>
                    <button class="button" @click="classifyModal = false">Cancel</button>
                </footer>
            </div>
        </div>

        {# -- Request reclassification modal (Conzent-classified beacons) -- #}
        <div class="modal" :class="{ 'is-active': reclassifyModal }">
            <div class="modal-background" @click="reclassifyModal = false"></div>
            <div class="modal-card">
                <header class="modal-card-head">
                    <p class="modal-card-title">Request category change</p>
                    <button class="delete" @click="reclassifyModal = false"></button>
                </header>
                <section class="modal-card-body">
                    <p class="mb-3"><code x-text="reclassifyForm.domain"></code> is currently classified as
                        <strong x-text="reclassifyForm.current_name"></strong> by Conzent.</p>
                    <div class="notification is-info is-light is-size-7">
                        Conzent maintains beacon classifications centrally. Your request will be reviewed — the category on your site stays unchanged until it is approved.
                    </div>
                    <div class="field">
                        <label class="label">Move to <span class="has-text-danger">*</span></label>
                        <div class="control">
                            <div class="select is-fullwidth">
                                <select x-model="reclassifyForm.category_id">
                                    <option value="">Select a category...</option>
                                    {% for c in beaconCategoryOptions|filter(c => c.slug != 'unclassified') %}
                                    <option value="{{ c.id }}">{{ c.name|default(c.slug|capitalize) }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="field">
                        <label class="label">Reason <span class="has-text-grey is-size-7">(optional)</span></label>
                        <div class="control">
                            <textarea class="textarea" x-model="reclassifyForm.reason" rows="2" placeholder="Why should this beacon be reclassified?"></textarea>
                        </div>
                    </div>
                    <div class="notification is-warning is-light" x-show="reclassifyError" x-text="reclassifyError"></div>
                </section>
                <footer class="modal-card-foot">
                    <button class="button is-primary" @click="submitReclassify()" :class="{ 'is-loading': reclassifySubmitting }">
                        <span class="icon"><i class="fas fa-paper-plane"></i></span><span>Submit request</span>
                    </button>
                    <button class="button" @click="reclassifyModal = false">Cancel</button>
                </footer>
            </div>
        </div>
    </div>
    {% endif %}


</div>
{% endblock %}

{% block head %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
{% endblock %}

{% block scripts %}
<script>
function beaconClassifier() {
    return {
        siteId: {{ siteId }},

        classifyModal: false,
        classifySubmitting: false,
        classifyError: '',
        classifyForm: { beacon_id: 0, domain: '', category_id: '' },

        reclassifyModal: false,
        reclassifySubmitting: false,
        reclassifyError: '',
        reclassifyForm: { domain: '', current_slug: '', current_name: '', category_id: '', reason: '' },

        openClassify(beaconId, domain) {
            this.classifyForm = { beacon_id: beaconId, domain: domain, category_id: '' };
            this.classifyError = '';
            this.classifyModal = true;
        },

        async submitClassify() {
            this.classifyError = '';
            if (!this.classifyForm.category_id) { this.classifyError = 'Please choose a category'; return; }
            this.classifySubmitting = true;
            try {
                const res = await fetch('/app/beacons/classify', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ beacon_id: this.classifyForm.beacon_id, category_id: parseInt(this.classifyForm.category_id) }),
                });
                const data = await res.json();
                if (data.success) { this.classifyModal = false; window.location.reload(); }
                else { this.classifyError = data.error?.message || 'Failed to classify beacon'; }
            } catch { this.classifyError = 'Network error'; }
            this.classifySubmitting = false;
        },

        openReclassify(domain, currentSlug, currentName) {
            this.reclassifyForm = { domain: domain, current_slug: currentSlug || '', current_name: currentName || currentSlug || '', category_id: '', reason: '' };
            this.reclassifyError = '';
            this.reclassifyModal = true;
        },

        async submitReclassify() {
            this.reclassifyError = '';
            if (!this.reclassifyForm.category_id) { this.reclassifyError = 'Please choose a target category'; return; }
            this.reclassifySubmitting = true;
            try {
                const res = await fetch('/app/beacons/reclassify-request', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        site_id: this.siteId,
                        beacon_domain: this.reclassifyForm.domain,
                        current_category_slug: this.reclassifyForm.current_slug,
                        requested_category_id: parseInt(this.reclassifyForm.category_id),
                        reason: this.reclassifyForm.reason,
                    }),
                });
                const data = await res.json();
                if (data.success) { this.reclassifyModal = false; window.location.reload(); }
                else { this.reclassifyError = data.error?.message || 'Failed to submit request'; }
            } catch { this.reclassifyError = 'Network error'; }
            this.reclassifySubmitting = false;
        },
    };
}
</script>
{% endblock %}
