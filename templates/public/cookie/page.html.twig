{# One cookie in the public database. Body only: the site shell wraps it. #}
<section class="hero">
  <div class="hero__content">
    <p style="margin:0 0 .5rem 0;font-size:.85rem;opacity:.75"><a href="/cookie/">Cookie database</a>{% for v in cookie.vendors|slice(0, 1) %} › <a href="{{ v.path is defined ? v.path : '/cookie/vendor/' ~ v.slug ~ '/' }}">{{ v.name }}</a>{% endfor %}</p>
    <h1 class="hero__title"><code style="font-size:.9em">{{ cookie.name }}</code> cookie</h1>
    <p class="hero__subtitle">{{ cookie.category_label }} cookie{% if cookie.vendors %} set by {{ cookie.vendors|map(v => v.name)|join(', ') }}{% endif %}{% if cookie.expiry %}, lasting {{ cookie.expiry }}{% endif %}.</p>
    {# The call to action continues the reader's own question: is this cookie a problem on my site.
       Necessary cookies need no consent, so they get the line about their neighbours instead.
       data-cta* feeds the site's cta_click event in GA4; the UTM tags carry the page into signup. #}
    {% set signup_url = 'https://app.getconzent.com/register?utm_source=getconzent&utm_medium=cookie_database&utm_campaign=cookie_cta&utm_content=' ~ cookie.name|url_encode %}
    <div style="margin:1.75rem auto 0;padding:1.25rem 1.5rem;border:1px solid rgba(255,255,255,.14);border-radius:12px;background:rgba(255,255,255,.04);max-width:44rem">
      {% if cookie.category == 'necessary' %}
      <p style="margin:0 0 .5rem 0;font-size:1.15rem;font-weight:700"><code>{{ cookie.name }}</code> doesn't need consent. The cookies next to it usually do.</p>
      <p style="margin:0 0 1rem 0">Conzent finds every cookie your site sets, sorts them the way this page does, and holds the ones that need a yes until the visitor gives it.</p>
      {% else %}
      <p style="margin:0 0 .5rem 0;font-size:1.15rem;font-weight:700">Is <code>{{ cookie.name }}</code> firing on your site before anyone says yes?</p>
      <p style="margin:0 0 1rem 0">Conzent holds <code>{{ cookie.name }}</code> and every other {{ cookie.category_label|lower }} cookie until the visitor accepts, and Consent Mode v2 keeps your Google Ads and GA4 reporting accurate. Registered IAB TCF CMP, Google-certified. From €7 per site a month.</p>
      {% endif %}
      <p style="margin:0;display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.75rem 1rem">
        <a href="{{ signup_url }}" class="btn btn-cta" style="padding:.7rem 1.1rem;border-radius:8px" data-cta="cookie_page_trial" data-cta-text="Try it free for 14 days ({{ cookie.name }})" data-cta-language="en" data-cta-location="cookie_hero">Try it free for 14 days</a>
        <span>or <a href="/oci/self-host/" data-cta="cookie_page_self_host" data-cta-text="Self-host it for free ({{ cookie.name }})" data-cta-language="en" data-cta-location="cookie_hero">self-host it for free</a></span>
      </p>
    </div>
  </div>
</section>
<section class="section">
  <div class="container">
    <article class="prose">
      <h2>What the {{ cookie.name }} cookie does</h2>
      {% for d in cookie.descriptions %}
      <p>{{ d }}</p>
      {% endfor %}
      {% if cookie.wildcard %}
      <p>The name ends in a part that changes from visitor to visitor or site to site, so this entry covers every cookie whose name starts with <code>{{ cookie.name|trim('*') }}</code>.</p>
      {% endif %}

      <h2>Who sets it</h2>
      {% if cookie.vendors %}
      <ul>
        {% for v in cookie.vendors %}
        <li><strong><a href="/cookie/vendor/{{ v.slug }}/">{{ v.name }}</a></strong>{% if v.controller and v.controller != v.name %} ({{ v.controller }}){% endif %}{% if v.privacy_url %} — <a href="{{ v.privacy_url }}" rel="nofollow noopener" target="_blank">privacy policy</a>{% endif %}</li>
        {% endfor %}
      </ul>
      {% else %}
      <p>The service behind this cookie is not named in our records yet.</p>
      {% endif %}

      <h2>Consent category: {{ cookie.category_label|lower }}</h2>
      <p>{{ cookie.category_text }}</p>

      <table style="border-collapse:collapse;margin-bottom:1.5rem">
        <tbody>
          <tr><th style="text-align:left;padding:.35rem 1.5rem .35rem 0;vertical-align:top">Name</th><td style="padding:.5rem .75rem .5rem 0;vertical-align:top"><code>{{ cookie.name }}</code></td></tr>
          <tr><th style="text-align:left;padding:.35rem 1.5rem .35rem 0;vertical-align:top">Category</th><td style="padding:.5rem .75rem .5rem 0;vertical-align:top">{{ cookie.category_label }}</td></tr>
          {% if cookie.expiry %}<tr><th style="text-align:left;padding:.35rem 1.5rem .35rem 0;vertical-align:top">Lifetime</th><td style="padding:.5rem .75rem .5rem 0;vertical-align:top">{{ cookie.expiry }}</td></tr>{% endif %}
          {% if cookie.vendors %}<tr><th style="text-align:left;padding:.35rem 1.5rem .35rem 0;vertical-align:top">Set by</th><td style="padding:.5rem .75rem .5rem 0;vertical-align:top">{{ cookie.vendors|map(v => v.name)|join(', ') }}</td></tr>{% endif %}
        </tbody>
      </table>

      {% if cookie.related %}
      <h2>Other cookies from the same vendor</h2>
      <ul>
        {% for r in cookie.related %}
        <li><a href="{{ r.path }}"><code>{{ r.name }}</code></a></li>
        {% endfor %}
      </ul>
      {% endif %}

      <h2>Is this cookie on your site?</h2>
      <p>Conzent's scanner lists every cookie your site sets, classifies each one the way this page does, and shows which are set before the visitor has consented. <a href="{{ signup_url }}" data-cta="cookie_page_trial" data-cta-text="Try Conzent free for 14 days ({{ cookie.name }})" data-cta-language="en" data-cta-location="cookie_footer">Try Conzent free for 14 days</a>, or <a href="/cookie/">look up another cookie</a>.</p>
      <p style="font-size:.85rem;opacity:.7">From the Conzent cookie database, last updated {{ generated }}. Descriptions come from vendor documentation, cookie policies and our own scans; write to <a href="mailto:support@getconzent.com">support@getconzent.com</a> to correct one.</p>
    </article>
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      "headline": {{ (cookie.name ~ ' cookie: what it does, who sets it, consent category')|json_encode|raw }},
      "description": {{ cookie.description|json_encode|raw }},
      "dateModified": {{ generated|json_encode|raw }},
      "author": {"@type": "Organization", "name": "Conzent"},
      "publisher": {"@type": "Organization", "name": "Conzent", "url": "https://getconzent.com"},
      "about": {"@type": "Thing", "name": {{ cookie.name|json_encode|raw }}}
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Cookie database", "item": "https://getconzent.com/cookie/"},
        {"@type": "ListItem", "position": 2, "name": {{ cookie.name|json_encode|raw }}, "item": {{ cookie.url|json_encode|raw }}}
      ]
    }
  ]
}
</script>
